// Optional two-sided public exchanges. One request per module; players take priority.
#include "sp_inc"
int AWSPlayerBusy(){object pc=GetFirstPC();while(GetIsObjectValid(pc)){if(GetLocalString(pc,"SP_PENDING")!="" || IsInConversation(pc) || GetIsInCombat(pc))return TRUE;pc=GetNextPC();}return FALSE;}
int AWSOptIn(object a,object b){json pa=AWAPolicy(a);json pb=AWAPolicy(b);json ap=JsonObjectGet(pa,"partners");json bp=JsonObjectGet(pb,"partners");return a!=b && AWInt(AWACfg(),"social") && AWInt(pa,"social_enabled") && AWInt(pb,"social_enabled") && AWInt(pa,"ai_enabled") && AWInt(pb,"ai_enabled") && (JsonGetLength(ap)==0 || AWCHas(ap,GetTag(b))) && (JsonGetLength(bp)==0 || AWCHas(bp,GetTag(a)));}
int AWSPairReady(object a,object b){return AWASafe(a) && AWASafe(b) && AWSOptIn(a,b) && !AWSPlayerBusy() && GetArea(a)==GetArea(b) && GetDistanceBetween(a,b)<=6.0 && LineOfSightObject(a,b) && GetObjectSeen(b,a) && GetObjectSeen(a,b) && AWANearPlayer(a) && GetCurrentAction(a)==ACTION_INVALID && GetCurrentAction(b)==ACTION_INVALID;}
string AWSHistory(object a,object b){return GetLocalString(a,"AWA_PUBLIC_"+GetObjectUUID(b));}
void AWSRemember(object a,object b,string text){string history=GetStringRight(AWSHistory(a,b)+"\n"+text,3000);SetLocalString(a,"AWA_PUBLIC_"+GetObjectUUID(b),history);SetLocalString(b,"AWA_PUBLIC_"+GetObjectUUID(a),history);}
void AWSCancel(){string id=GetLocalString(GetModule(),"AWS_PENDING");if(id!=""){sqlquery q=SqlPrepareQueryCampaign(SPDB,"UPDATE sp_requests SET state='expired' WHERE request_id=@id AND session_id=@session AND state IN ('queued','working','ready')");SqlBindString(q,"@id",id);SqlBindString(q,"@session",SPSession());SqlStep(q);}
 DeleteLocalInt(GetLocalObject(GetModule(),"AWS_A"),"AWA_SOCIAL_LOCK");DeleteLocalInt(GetLocalObject(GetModule(),"AWS_B"),"AWA_SOCIAL_LOCK");DeleteLocalString(GetModule(),"AWS_PENDING");DeleteLocalInt(GetModule(),"AWS_STAGE");}
int AWSFresh(object a,object b){return AWSPairReady(a,b) && GetObjectUUID(a)==GetLocalString(GetModule(),"AWS_A_ID") && GetObjectUUID(b)==GetLocalString(GetModule(),"AWS_B_ID") && GetLocalInt(a,"AWA_EPOCH")==GetLocalInt(GetModule(),"AWS_A_EPOCH") && GetLocalInt(b,"AWA_EPOCH")==GetLocalInt(GetModule(),"AWS_B_EPOCH");}
void AWSPoll(){object a=GetLocalObject(GetModule(),"AWS_A");object b=GetLocalObject(GetModule(),"AWS_B");if(!AWSFresh(a,b) || AWMClock()>=GetLocalInt(GetModule(),"AWS_EXPIRES") || SPNow()-GetLocalInt(GetModule(),"AWS_SENT")>=90){AWSCancel();return;}
 if(GetLocalInt(GetModule(),"AWS_STAGE")==1){if(AWMClock()<GetLocalInt(GetModule(),"AWS_REPLY_AT"))return;string line=GetLocalString(GetModule(),"AWS_LINE_B");AssignCommand(b,SpeakString(line,TALKVOLUME_TALK));AWSRemember(a,b,GetName(b)+": "+line);AWSCancel();return;}
 sqlquery q=SqlPrepareQueryCampaign(SPDB,"SELECT state,response FROM sp_requests WHERE request_id=@id AND session_id=@session");SqlBindString(q,"@id",GetLocalString(GetModule(),"AWS_PENDING"));SqlBindString(q,"@session",SPSession());if(!SqlStep(q))return;string state=SqlGetString(q,0);if(state=="queued" || state=="working")return;if(state!="ready"){AWSCancel();return;}
 json result=JsonParse(SqlGetString(q,1));string first=GetStringLeft(AWText(result,"line_a"),280);string second=GetStringLeft(AWText(result,"line_b"),280);if(first=="" || second=="" || AWText(result,"action")!="none"){AWSCancel();return;}
 sqlquery ack=SqlPrepareQueryCampaign(SPDB,"UPDATE sp_requests SET state='consumed' WHERE request_id=@id AND session_id=@session AND state='ready'");SqlBindString(ack,"@id",GetLocalString(GetModule(),"AWS_PENDING"));SqlBindString(ack,"@session",SPSession());SqlStep(ack);if(SqlGetError(ack)!=""){AWSCancel();return;}
 AssignCommand(a,SpeakString(first,TALKVOLUME_TALK));AWSRemember(a,b,GetName(a)+": "+first);SetLocalString(GetModule(),"AWS_LINE_B",second);SetLocalInt(GetModule(),"AWS_STAGE",1);SetLocalInt(GetModule(),"AWS_REPLY_AT",AWMClock()+6);}
void AWSTick(object pc){if(GetLocalString(GetModule(),"AWS_PENDING")!=""){AWSPoll();return;}if(!AWInt(AWACfg(),"social") || AWSPlayerBusy() || AWMClock()<GetLocalInt(GetModule(),"AWS_NEXT"))return;
 if(AWMClock()>=GetLocalInt(GetModule(),"AWS_WINDOW")+3600){SetLocalInt(GetModule(),"AWS_WINDOW",AWMClock());SetLocalInt(GetModule(),"AWS_USED",0);}if(GetLocalInt(GetModule(),"AWS_USED")>=AWInt(AWACfg(),"social_budget"))return;
 json all=AWABehaviors();int total=JsonGetLength(all);if(total<2)return;int offset=GetLocalInt(GetModule(),"AWS_CURSOR")%total;json candidates=JsonArray();int i=0;
 while(i<total && JsonGetLength(candidates)<12){json p=JsonArrayGet(all,(i+offset)%total);object actor=GetObjectByTag(AWText(p,"id"));if(AWInt(p,"social_enabled") && AWASafe(actor) && AWANearPlayer(actor) && AWMClock()>=GetLocalInt(actor,"AWS_NEXT") && GetCurrentAction(actor)==ACTION_INVALID)candidates=JsonArrayInsert(candidates,JsonString(GetObjectUUID(actor)));i++;}
 SetLocalInt(GetModule(),"AWS_CURSOR",offset+1);object a=OBJECT_INVALID;object b=OBJECT_INVALID;i=0;while(i<JsonGetLength(candidates) && !GetIsObjectValid(a)){int j=i+1;while(j<JsonGetLength(candidates) && !GetIsObjectValid(a)){object x=GetObjectByUUID(JsonGetString(JsonArrayGet(candidates,i)));object y=GetObjectByUUID(JsonGetString(JsonArrayGet(candidates,j)));if(AWSPairReady(x,y)){a=x;b=y;}j++;}i++;}if(!GetIsObjectValid(a))return;
 string id=GetRandomUUID();json payload=JsonObject();payload=JsonObjectSet(payload,"source",JsonString(GetTag(a)));payload=JsonObjectSet(payload,"target",JsonString(GetTag(b)));payload=JsonObjectSet(payload,"source_uuid",JsonString(GetObjectUUID(a)));payload=JsonObjectSet(payload,"target_uuid",JsonString(GetObjectUUID(b)));payload=JsonObjectSet(payload,"history",JsonString(AWSHistory(a,b)));
 // The bridge receives no player's transcript or full quest state for ambient speech.
 payload=JsonObjectSet(payload,"game",JsonObject());sqlquery q=SqlPrepareQueryCampaign(SPDB,"INSERT INTO sp_requests(request_id,session_id,kind,npc_tag,payload,created,updated) VALUES(@id,@session,'social','',@payload,CAST(strftime('%s','now') AS INTEGER),CAST(strftime('%s','now') AS INTEGER))");SqlBindString(q,"@id",id);SqlBindString(q,"@session",SPSession());SqlBindString(q,"@payload",JsonDump(payload));SqlStep(q);
 SetLocalInt(GetModule(),"AWS_NEXT",AWMClock()+AWInt(AWACfg(),"social_interval"));SetLocalInt(GetModule(),"AWS_USED",GetLocalInt(GetModule(),"AWS_USED")+1);SetLocalInt(a,"AWS_NEXT",AWMClock()+AWInt(AWAPolicy(a),"cooldown"));SetLocalInt(b,"AWS_NEXT",AWMClock()+AWInt(AWAPolicy(b),"cooldown"));if(SqlGetError(q)!="")return;
 SetLocalInt(GetModule(),"AWS_SENT",SPNow());SetLocalString(GetModule(),"AWS_PENDING",id);SetLocalObject(GetModule(),"AWS_A",a);SetLocalObject(GetModule(),"AWS_B",b);SetLocalString(GetModule(),"AWS_A_ID",GetObjectUUID(a));SetLocalString(GetModule(),"AWS_B_ID",GetObjectUUID(b));SetLocalInt(GetModule(),"AWS_A_EPOCH",GetLocalInt(a,"AWA_EPOCH"));SetLocalInt(GetModule(),"AWS_B_EPOCH",GetLocalInt(b,"AWA_EPOCH"));SetLocalInt(a,"AWA_SOCIAL_LOCK",TRUE);SetLocalInt(b,"AWA_SOCIAL_LOCK",TRUE);SetLocalInt(GetModule(),"AWS_EXPIRES",AWMClock()+90);}
