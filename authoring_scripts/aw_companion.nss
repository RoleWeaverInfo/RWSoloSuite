// Native ownership, save-local memory and recoverable companion storage.
#include "aw_merchant"
#include "aw_cp_pack"
#include "aw_dlg_pref"

json AWCCfg(){return JsonArrayGet(AWCompanionConfig(),0);}
int AWCEnabled(){return AWInt(AWCCfg(),"enabled");}
object AWCOwner(object body){object owner=GetMaster(body);int depth=0;while(GetIsObjectValid(owner) && !GetIsPC(owner) && depth<8){owner=GetMaster(owner);depth++;}return owner;}
int AWCLinked(object body){object master=GetMaster(body);if(!GetIsObjectValid(master))return FALSE;int type=GetAssociateType(body);if(type!=ASSOCIATE_TYPE_HENCHMAN && type!=ASSOCIATE_TYPE_FAMILIAR && type!=ASSOCIATE_TYPE_SUMMONED)return FALSE;int i=1;object candidate=GetAssociate(type,master,i);while(GetIsObjectValid(candidate) && i<=16){if(candidate==body)return TRUE;i++;candidate=GetAssociate(type,master,i);}return FALSE;}
json AWCPolicy(object body){json npc=AWFind(AWCompanionNPCs(),GetTag(body));if(AWInt(npc,"recruitable") && GetResRef(body)==AWText(npc,"id") && (GetAssociateType(body)==ASSOCIATE_TYPE_NONE || GetAssociateType(body)==ASSOCIATE_TYPE_HENCHMAN))return npc;
 int type=GetAssociateType(body);string kind="";if(type==ASSOCIATE_TYPE_FAMILIAR && AWInt(AWCCfg(),"familiars"))kind="familiar";if(type==ASSOCIATE_TYPE_SUMMONED && AWInt(AWCCfg(),"summons"))kind="summon";if(kind=="")return JsonNull();
 int familiar=kind=="familiar"?GetFamiliarCreatureType(GetMaster(body)):-1;json list=AWCompanionTemplates();json fallback=JsonNull();json typed=JsonNull();int i=0;
 while(i<JsonGetLength(list)){json p=JsonArrayGet(list,i);if(AWText(p,"kind")==kind){json refs=JsonObjectGet(p,"blueprints");int j=0;while(j<JsonGetLength(refs)){if(JsonGetString(JsonArrayGet(refs,j))==GetResRef(body))return p;j++;}
 if(kind=="familiar" && AWInt(p,"familiar_type")==familiar && familiar!=-1)typed=p;
 if(AWInt(p,"familiar_type")==-1 && JsonGetLength(refs)==0)fallback=p;}i++;}if(AWText(typed,"id")!="")return typed;return fallback;}
string AWCKind(object body){if(AWInt(AWCPolicy(body),"recruitable"))return "party";if(GetAssociateType(body)==ASSOCIATE_TYPE_FAMILIAR)return "familiar";if(GetAssociateType(body)==ASSOCIATE_TYPE_SUMMONED)return "summon";return "";}
int AWCReady(object pc,object body,int owned=TRUE){return AWCEnabled() && GetIsPC(pc) && !GetIsDead(pc) && GetIsObjectValid(body) && GetObjectType(body)==OBJECT_TYPE_CREATURE && !GetIsPC(body) && !GetIsDead(body) && !GetIsDMPossessed(body) && !GetIsPossessedFamiliar(body) && GetCommandable(body) && !GetIsInCombat(pc) && !GetIsInCombat(body) && GetArea(pc)==GetArea(body) && GetDistanceBetween(pc,body)<=12.0 && LineOfSightObject(pc,body) && AWText(AWCPolicy(body),"id")!="" && ((AWCOwner(body)==pc && AWCLinked(body)) || (!owned && !GetIsObjectValid(GetMaster(body)) && AWCKind(body)=="party"));}
string AWCIdentity(object pc,object body){string kind=AWCKind(body);string id=AWCWorld()+"|"+GetObjectUUID(pc)+"|"+kind+":";
 if(kind=="party")return id+GetTag(body);
 if(kind=="familiar"){int type=GetFamiliarCreatureType(GetMaster(body));return id+GetObjectUUID(GetMaster(body))+":"+IntToString(type)+":"+(type==255?GetResRef(body):"");}
 if(kind=="summon")return id+GetObjectUUID(body);return "";}
void AWCInit(){if(!AWCEnabled())return;
 sqlquery q=SqlPrepareQueryObject(GetModule(),"CREATE TABLE IF NOT EXISTS awc_memory (identity TEXT PRIMARY KEY,owner TEXT NOT NULL,profile TEXT NOT NULL,kind TEXT NOT NULL,instance TEXT NOT NULL,epoch INTEGER NOT NULL DEFAULT 0,history TEXT NOT NULL DEFAULT '',ai INTEGER NOT NULL DEFAULT 1,movement INTEGER NOT NULL DEFAULT 1,inventory INTEGER NOT NULL DEFAULT 1,reply INTEGER NOT NULL DEFAULT 3,tone INTEGER NOT NULL DEFAULT 0,touched INTEGER NOT NULL DEFAULT 0,receipt TEXT NOT NULL DEFAULT '')");SqlStep(q);}
json AWCRecord(object pc,string identity){json out=JsonObject();sqlquery q=SqlPrepareQueryObject(GetModule(),"SELECT epoch,history,ai,movement,inventory,reply,tone,instance,receipt FROM awc_memory WHERE identity=@id AND owner=@owner");SqlBindString(q,"@id",identity);SqlBindString(q,"@owner",GetObjectUUID(pc));if(!SqlStep(q))return out;
 out=JsonObjectSet(out,"epoch",JsonInt(SqlGetInt(q,0)));out=JsonObjectSet(out,"history",JsonString(SqlGetString(q,1)));out=JsonObjectSet(out,"ai",JsonInt(SqlGetInt(q,2)));out=JsonObjectSet(out,"movement",JsonInt(SqlGetInt(q,3)));out=JsonObjectSet(out,"inventory",JsonInt(SqlGetInt(q,4)));out=JsonObjectSet(out,"reply",JsonInt(SqlGetInt(q,5)));out=JsonObjectSet(out,"tone",JsonInt(SqlGetInt(q,6)));out=JsonObjectSet(out,"receipt",JsonString(SqlGetString(q,8)));return JsonObjectSet(out,"instance",JsonString(SqlGetString(q,7)));}
void AWCReceipt(object pc,string identity,string text){sqlquery q=SqlPrepareQueryObject(GetModule(),"UPDATE awc_memory SET receipt=@text WHERE identity=@id AND owner=@owner");SqlBindString(q,"@text",GetStringLeft(text,1000));SqlBindString(q,"@id",identity);SqlBindString(q,"@owner",GetObjectUUID(pc));SqlStep(q);}
void AWCHook(object body){string base=GetEventScript(body,EVENT_SCRIPT_CREATURE_ON_DIALOGUE);if(base!="aw_cp_dialog"){SetLocalString(body,"AWC_BASE_DIALOG",base);SetEventScript(body,EVENT_SCRIPT_CREATURE_ON_DIALOGUE,"aw_cp_dialog");}
 base=GetEventScript(body,EVENT_SCRIPT_CREATURE_ON_DEATH);if(base!="aw_cp_dead"){SetLocalString(body,"AWC_BASE_DEATH",base);SetEventScript(body,EVENT_SCRIPT_CREATURE_ON_DEATH,"aw_cp_dead");}}
int AWCObserve(object pc,object body){if(!AWCEnabled() || AWText(AWCPolicy(body),"id")=="")return FALSE;string identity=AWCIdentity(pc,body);if(identity=="")return FALSE;AWCInit();json previous=AWCRecord(pc,identity);
 if(AWText(previous,"instance")==""){sqlquery count=SqlPrepareQueryObject(GetModule(),"SELECT COUNT(*) FROM awc_memory");if(SqlStep(count) && SqlGetInt(count,0)>=256){
  sqlquery old=SqlPrepareQueryObject(GetModule(),"SELECT identity,instance FROM awc_memory WHERE kind='summon' ORDER BY touched LIMIT 32");int removed=FALSE;while(SqlStep(old)){object prior=GetObjectByUUID(SqlGetString(old,1));if(!GetIsObjectValid(prior) || GetIsDead(prior) || !GetIsObjectValid(GetMaster(prior))){sqlquery drop=SqlPrepareQueryObject(GetModule(),"DELETE FROM awc_memory WHERE identity=@id");SqlBindString(drop,"@id",SqlGetString(old,0));SqlStep(drop);removed=TRUE;break;}}if(!removed)return FALSE;}
  sqlquery insert=SqlPrepareQueryObject(GetModule(),"INSERT OR IGNORE INTO awc_memory(identity,owner,profile,kind,instance,touched,ai,reply) VALUES(@id,@owner,@profile,@kind,@instance,@time,1,3)");SqlBindString(insert,"@id",identity);SqlBindString(insert,"@owner",GetObjectUUID(pc));SqlBindString(insert,"@profile",AWText(AWCPolicy(body),"id"));SqlBindString(insert,"@kind",AWCKind(body));SqlBindString(insert,"@instance",GetObjectUUID(body));SqlBindInt(insert,"@time",AWMClock());SqlStep(insert);if(SqlGetError(insert)!="")return FALSE;
 }else if(AWText(previous,"instance")!=GetObjectUUID(body)){
  // A newly summoned body starts with conversation on. Do not reset an off
  // choice during repeated observations of the same living companion.
  sqlquery change=SqlPrepareQueryObject(GetModule(),"UPDATE awc_memory SET instance=@instance,epoch=epoch+1,touched=@time,ai=CASE WHEN kind IN ('familiar','summon') THEN 1 ELSE ai END WHERE identity=@id AND owner=@owner");SqlBindString(change,"@instance",GetObjectUUID(body));SqlBindString(change,"@id",identity);SqlBindString(change,"@owner",GetObjectUUID(pc));SqlBindInt(change,"@time",AWMClock());SqlStep(change);}
 AWCHook(body);return TRUE;}
void AWCSet(object pc,string identity,string field,int value){if(field!="ai" && field!="movement" && field!="inventory" && field!="reply" && field!="tone")return;int maximum=1;if(field=="reply")maximum=3;if(field=="tone")maximum=4;if(value<0 || value>maximum)return;
 sqlquery q=SqlPrepareQueryObject(GetModule(),"UPDATE awc_memory SET "+field+"=@v,epoch=epoch+1 WHERE identity=@id AND owner=@owner");SqlBindInt(q,"@v",value);SqlBindString(q,"@id",identity);SqlBindString(q,"@owner",GetObjectUUID(pc));SqlStep(q);}
void AWCHistorySet(object pc,object body,string history){string id=AWCIdentity(pc,body);sqlquery q=SqlPrepareQueryObject(GetModule(),"UPDATE awc_memory SET history=@history WHERE identity=@id AND owner=@owner");SqlBindString(q,"@history",GetStringRight(history,6000));SqlBindString(q,"@id",id);SqlBindString(q,"@owner",GetObjectUUID(pc));SqlStep(q);}
string AWCMode(object body){string mode=AWText(AWCPolicy(body),"communication");if(mode=="auto")return GetRacialType(body)==RACIAL_TYPE_ANIMAL || GetAbilityScore(body,ABILITY_INTELLIGENCE)<3?"nonverbal":"speech";return mode;}
int AWCCanRecruit(object pc,object body){if(!AWCReady(pc,body,FALSE) || GetIsObjectValid(GetMaster(body)) || AWCKind(body)!="party" || !AQDone(AWText(AWCPolicy(body),"requires_quest")))return FALSE;
 int count=0;while(GetIsObjectValid(GetHenchman(pc,count+1)) && count<16)count++;return count<AWInt(AWCCfg(),"party_limit");}
json AWCAllowed(object pc,object body,json record){json out=JsonArray();if(!AWCReady(pc,body,FALSE))return out;
 if(AWCCanRecruit(pc,body))return JsonArrayInsert(out,JsonString("recruit"));if(AWCOwner(body)!=pc)return out;
 if(AWCKind(body)=="party")out=JsonArrayInsert(out,JsonString("dismiss"));json policy=AWCPolicy(body);
 if(AWInt(policy,"movement") && AWInt(record,"movement")){out=JsonArrayInsert(out,JsonString("follow"));out=JsonArrayInsert(out,JsonString("stay"));out=JsonArrayInsert(out,JsonString("guard"));}
 if(AWInt(policy,"inventory") && AWInt(record,"inventory"))out=JsonArrayInsert(out,JsonString("inventory"));return out;}
int AWCHas(json list,string value){int i=0;while(i<JsonGetLength(list)){if(JsonGetString(JsonArrayGet(list,i))==value)return TRUE;i++;}return FALSE;}
json AWCActors(object pc){json out=JsonArray();if(!AWCEnabled())return out;object caster=pc;int root=0;int total=0;
 while(GetIsObjectValid(caster) && root<=7){int type=1;while(type<=4){if(type==2){type++;continue;}if(root>0 && type==1){type++;continue;}int i=1;object body=GetAssociate(type,caster,i);
  while(GetIsObjectValid(body) && i<=16 && total<32){if(AWCOwner(body)==pc && AWText(AWCPolicy(body),"id")!="" && !AWCHas(out,GetObjectUUID(body))){out=JsonArrayInsert(out,JsonString(GetObjectUUID(body)));total++;}i++;body=GetAssociate(type,caster,i);}type++;}
 root++;caster=GetHenchman(pc,root);}return out;}
object AWCFind(object pc,string name){json bodies=AWCActors(pc);object found=OBJECT_INVALID;int count=0;int i=0;int summons=0;while(i<JsonGetLength(bodies)){object body=GetObjectByUUID(JsonGetString(JsonArrayGet(bodies,i)));string full=GetStringLowerCase(GetName(body));int at=FindSubString(full," ");string first=at<0?full:GetStringLeft(full,at);string slot="";
 if(AWCKind(body)=="familiar")slot="familiar";if(AWCKind(body)=="summon"){summons++;slot="summon"+IntToString(summons);}
 if(name==full || name==first || name==slot || name==GetStringLowerCase(GetTag(body))){found=body;count++;}i++;}SetLocalInt(pc,"AWC_AMBIGUOUS",count>1);if(count!=1)return OBJECT_INVALID;return found;}
string AWCVersion(object pc,object body){if(!AWCReady(pc,body,FALSE) || !AWCObserve(pc,body))return "";json record=AWCRecord(pc,AWCIdentity(pc,body));return GetObjectUUID(body)+"|"+GetObjectUUID(AWCOwner(body))+"|"+IntToString(AWInt(record,"epoch"))+"|"+IntToString(GetLocalInt(body,"AWC_CONTROL_EPOCH"))+"|"+IntToString(GetLastAssociateCommand(body));}
int AWCAIReady(object pc,object body){if(GetLocalInt(body,"AWT_ACTIVE"))return FALSE;if(AWText(AWCPolicy(body),"id")=="" || !AWCEnabled())return TRUE;if(!AWCReady(pc,body,FALSE) || !AWCObserve(pc,body) || GetEventScript(body,EVENT_SCRIPT_CREATURE_ON_DIALOGUE)!="aw_cp_dialog")return FALSE;
 json p=AWCPolicy(body);if(!AWInt(p,"ai_enabled"))return FALSE;return AWInt(AWCRecord(pc,AWCIdentity(pc,body)),"ai");}
object AWCSatchel(object pc,string identity,string label,int create=FALSE){object found=OBJECT_INVALID;int matches=0;int scanned=0;object item=GetFirstItemInInventory(pc);while(GetIsObjectValid(item) && scanned<2048){if(GetLocalString(item,"AWC_PACK_ID")==identity && GetLocalString(item,"AWC_PACK_WORLD")==AWCWorld() && GetItemPossessor(item,TRUE)==pc){found=item;matches++;}item=GetNextItemInInventory(pc);scanned++;}
 if(matches>1 || GetIsObjectValid(item))return OBJECT_INVALID;if(matches==1 || !create)return found;
 object bag=CreateItemOnObject("aw_satchel",pc);if(!GetIsObjectValid(bag) || !GetHasInventory(bag))return OBJECT_INVALID;SetLocalString(bag,"AWC_PACK_ID",identity);SetLocalString(bag,"AWC_PACK_WORLD",AWCWorld());SetName(bag,label+" satchel");SetPlotFlag(bag,TRUE);SetDroppableFlag(bag,FALSE);SetIdentified(bag,TRUE);return bag;}
json AWCObservation(object pc,object body){json out=JsonObject();out=JsonObjectSet(out,"area",JsonString(GetName(GetArea(body))));out=JsonObjectSet(out,"hp",JsonInt(GetCurrentHitPoints(body)));out=JsonObjectSet(out,"max_hp",JsonInt(GetMaxHitPoints(body)));out=JsonObjectSet(out,"level",JsonInt(GetHitDice(body)));json seen=JsonArray();object item=GetFirstObjectInArea(GetArea(body));int scanned=0;int count=0;
 while(GetIsObjectValid(item) && scanned<128 && count<12){if(item!=body && GetDistanceBetween(body,item)<=12.0 && LineOfSightObject(body,item) && (GetObjectType(item)==OBJECT_TYPE_CREATURE?GetObjectSeen(item,body):GetObjectType(item)==OBJECT_TYPE_PLACEABLE && GetHasInventory(item) && AQDone(GetLocalString(item,"AW_GATE"))) && !GetIsDM(item) && !GetIsDMPossessed(item)){
 json view=JsonObject();view=JsonObjectSet(view,"name",JsonString(item==pc?"Your owner":GetIsPC(item)?"Unidentified traveler":GetName(item)));view=JsonObjectSet(view,"distance",JsonInt(FloatToInt(GetDistanceBetween(body,item))));seen=JsonArrayInsert(seen,view);count++;}item=GetNextObjectInArea(GetArea(body));scanned++;}return JsonObjectSet(out,"visible",seen);}
json AWCContext(object pc,object body){json out=JsonObject();if(!AWCEnabled() || AWText(AWCPolicy(body),"id")=="" || !AWCReady(pc,body,FALSE) || !AWCObserve(pc,body))return out;json policy=AWCPolicy(body);json record=AWCRecord(pc,AWCIdentity(pc,body));out=JsonObjectSet(out,"status",JsonString(AWText(record,"receipt")));
 out=JsonObjectSet(out,"available",JsonInt(!IsInConversation(pc) && !IsInConversation(body)));out=JsonObjectSet(out,"actor_uuid",JsonString(GetObjectUUID(body)));out=JsonObjectSet(out,"owner_uuid",JsonString(GetObjectUUID(pc)));out=JsonObjectSet(out,"owned",JsonInt(AWCOwner(body)==pc));out=JsonObjectSet(out,"identity",JsonString(AWCIdentity(pc,body)));out=JsonObjectSet(out,"kind",JsonString(AWCKind(body)));out=JsonObjectSet(out,"profile",JsonString(AWText(policy,"id")));out=JsonObjectSet(out,"name",JsonString(GetName(body)));out=JsonObjectSet(out,"resref",JsonString(GetResRef(body)));out=JsonObjectSet(out,"familiar_type",JsonInt(AWCKind(body)=="familiar"?GetFamiliarCreatureType(GetMaster(body)):-1));out=JsonObjectSet(out,"intelligence",JsonInt(GetAbilityScore(body,ABILITY_INTELLIGENCE)));out=JsonObjectSet(out,"animal",JsonInt(GetRacialType(body)==RACIAL_TYPE_ANIMAL));out=JsonObjectSet(out,"ai_enabled",JsonInt(AWInt(record,"ai")));out=JsonObjectSet(out,"reply_style",JsonInt(AWInt(record,"reply")));out=JsonObjectSet(out,"tone",JsonInt(AWInt(record,"tone")));out=JsonObjectSet(out,"allowed_actions",AWCAllowed(pc,body,record));json observed=AWCObservation(pc,body);if(AWCOwner(body)==pc){object holder=AWCPersistentPack(pc,AWCIdentity(pc,body),GetName(body),FALSE);json items=JsonArray();object item=GetFirstItemInInventory(holder);int count=0;int scanned=0;while(GetIsObjectValid(item) && count<8 && scanned<128){if(!GetPlotFlag(item) && GetIdentified(item) && !GetItemCursedFlag(item) && !GetHasInventory(item)){json entry=JsonObject();entry=JsonObjectSet(entry,"name",JsonString(GetName(item)));entry=JsonObjectSet(entry,"quantity",JsonInt(GetItemStackSize(item)));items=JsonArrayInsert(items,entry);count++;}item=GetNextItemInInventory(holder);scanned++;}observed=JsonObjectSet(observed,"companion_inventory",items);}return JsonObjectSet(out,"observation",observed);}

void AWCOrder(object pc,object body,string command){if(!AWCReady(pc,body,FALSE) || !AWCObserve(pc,body)){SendMessageToPC(pc,"This companion is unavailable, controlled, fighting or too far away.");return;}json record=AWCRecord(pc,AWCIdentity(pc,body));if(!AWCHas(AWCAllowed(pc,body,record),command)){SendMessageToPC(pc,"That companion command is not currently permitted.");return;}
 SetLocalInt(body,"AWC_CONTROL_EPOCH",GetLocalInt(body,"AWC_CONTROL_EPOCH")+1);
 if(command=="recruit"){AddHenchman(pc,body);if(GetMaster(body)==pc){SetAssociateListenPatterns(body);AWCReceipt(pc,AWCIdentity(pc,body),"Native party ownership confirmed recruitment.");SendMessageToPC(pc,GetName(body)+" has joined your party.");}else SendMessageToPC(pc,"Recruitment was not accepted by the game.");return;}
 if(command=="dismiss"){RemoveHenchman(pc,body);if(!GetIsObjectValid(GetMaster(body))){AWCReceipt(pc,AWCIdentity(pc,body),"Native party ownership confirmed dismissal.");AssignCommand(body,ClearAllActions(TRUE));ChangeToStandardFaction(body,STANDARD_FACTION_COMMONER);SendMessageToPC(pc,GetName(body)+" has left the party. Their character and memory remain in this save.");}return;}
 if(command=="follow" || command=="stay" || command=="guard"){SetLocalObject(body,"AWC_ORDER_OWNER",pc);SetLocalString(body,"AWC_ORDER",command);DeleteLocalInt(body,"AWC_ORDER_OK");ExecuteScript("aw_cp_order",body);if(GetLocalInt(body,"AWC_ORDER_OK")){AWCReceipt(pc,AWCIdentity(pc,body),"Native "+command+" order accepted; actual movement still uses game pathfinding.");SendMessageToPC(pc,GetName(body)+": "+command+" order accepted by native associate AI.");}else SendMessageToPC(pc,"The game could not accept that order.");}}
int AWCTravel(object pc,object body){if(!AWCEnabled() || AWCOwner(body)!=pc || AWText(AWCPolicy(body),"id")=="")return TRUE;ExecuteScript("aw_cp_probe",body);return !GetLocalInt(body,"AWC_WAIT");}
