#include "aw_companion"

void AWCUIClose(object pc){int token=GetLocalInt(pc,"AWC_TOKEN");DeleteLocalInt(pc,"AWC_TOKEN");if(token && GetLocalString(pc,"AWC_UI_SESSION")==GetLocalString(GetModule(),"AWM_SESSION"))NuiDestroy(pc,token);}
void AWCUILaunch(object pc,json rows,string title,int count,string view){AWCUIClose(pc);int gen=GetLocalInt(pc,"AWC_UI_GEN")+1;SetLocalInt(pc,"AWC_UI_GEN",gen);SetLocalString(pc,"AWC_UI_SESSION",GetLocalString(GetModule(),"AWM_SESSION"));SetLocalString(pc,"AWC_VIEW",view);
 float height=150.0+IntToFloat(count)*35.0;if(height>570.0)height=570.0;json window=AWUIWindow(AWUICol(rows),JsonString(title),AWUIRect(-1.0,-1.0,650.0,height),JsonBool(FALSE),JsonBool(FALSE),JsonBool(TRUE),JsonBool(FALSE),JsonBool(TRUE));
 SetLocalInt(pc,"AWC_TOKEN",NuiCreate(pc,window,"aw_companions_"+IntToString(gen),"aw_cp_ui_evt"));}
json AWCLabel(string label){return AWUIHeight(AWUILabel(JsonString(label),JsonInt(1),JsonInt(0)),28.0);}
json AWCButton(object pc,string label,string id,int enabled=TRUE){return AWUIHeight(AWUIEnabled(AWUIId(AWUIButton(JsonString(label)),id+"_"+IntToString(GetLocalInt(pc,"AWC_UI_GEN")+1)),JsonBool(enabled)),32.0);}
void AWCOpenList(object pc){if(!GetIsPC(pc) || GetIsDead(pc))return;if(!AWCEnabled()){SendMessageToPC(pc,"Companion support is disabled in this module.");return;}json bodies=AWCActors(pc);object body=GetFirstObjectInArea(GetArea(pc));int scanned=0;
 while(GetIsObjectValid(body) && scanned<128 && JsonGetLength(bodies)<64){if(GetObjectType(body)==OBJECT_TYPE_CREATURE && !GetIsDead(body) && !GetIsObjectValid(GetMaster(body)) && AWCKind(body)=="party" && AWCReady(pc,body,FALSE) && !AWCHas(bodies,GetObjectUUID(body)))bodies=JsonArrayInsert(bodies,JsonString(GetObjectUUID(body)));body=GetNextObjectInArea(GetArea(pc));scanned++;}
 int page=GetLocalInt(pc,"AWC_LIST_PAGE");if(page*8>=JsonGetLength(bodies))page=0;SetLocalInt(pc,"AWC_LIST_PAGE",page);json rows=JsonArray();rows=JsonArrayInsert(rows,AWCLabel("Your companions and nearby recruits. Select a character."));int start=page*8;int i=start;int shown=0;
 while(i<JsonGetLength(bodies) && shown<8){body=GetObjectByUUID(JsonGetString(JsonArrayGet(bodies,i)));SetLocalObject(pc,"AWC_ROW_"+IntToString(shown),body);string label=GetName(body)+" | "+AWCKind(body)+(AWCOwner(body)==pc?" | bonded":" | recruitable");rows=JsonArrayInsert(rows,AWCButton(pc,label,"actor"+IntToString(shown),AWCReady(pc,body,FALSE)));shown++;i++;}
 if(!shown)rows=JsonArrayInsert(rows,AWCLabel("No available companions. Summon normally or approach a recruit."));SetLocalInt(pc,"AWC_ROWS",shown);
 json nav=JsonArray();nav=JsonArrayInsert(nav,AWCButton(pc,"Previous","previous",page>0));nav=JsonArrayInsert(nav,AWCButton(pc,"Next","next",i<JsonGetLength(bodies)));rows=JsonArrayInsert(rows,AWUIRow(nav));rows=JsonArrayInsert(rows,AWCButton(pc,"Recover familiar / summon satchels","recover"));rows=JsonArrayInsert(rows,AWCButton(pc,"Close","close"));AWCUILaunch(pc,rows,"Companions",shown+4,"list");}
void AWCOpenControl(object pc,object body){if(!AWCReady(pc,body,FALSE) || !AWCObserve(pc,body)){SendMessageToPC(pc,"Approach an available companion, out of combat and native control.");return;}
 SetLocalObject(pc,"AWC_UI_ACTOR",body);SetLocalInt(body,"AWC_CONTROL_EPOCH",GetLocalInt(body,"AWC_CONTROL_EPOCH")+1);json record=AWCRecord(pc,AWCIdentity(pc,body));json policy=AWCPolicy(body);json allowed=AWCAllowed(pc,body,record);json rows=JsonArray();rows=JsonArrayInsert(rows,AWCLabel(GetName(body)+" | "+AWCKind(body)+" | "+AWCMode(body)));
 if(AWCOwner(body)!=pc){rows=JsonArrayInsert(rows,AWCButton(pc,"Join my party","recruit",AWCHas(allowed,"recruit")));if(!AWCHas(allowed,"recruit"))rows=JsonArrayInsert(rows,AWCLabel("Recruitment requires its quest condition and a free party slot."));}
 else {json orders=JsonArray();orders=JsonArrayInsert(orders,AWCButton(pc,"Follow","follow",AWCHas(allowed,"follow")));orders=JsonArrayInsert(orders,AWCButton(pc,"Stand ground","stay",AWCHas(allowed,"stay")));orders=JsonArrayInsert(orders,AWCButton(pc,"Guard master","guard",AWCHas(allowed,"guard")));rows=JsonArrayInsert(rows,AWUIRow(orders));
 rows=JsonArrayInsert(rows,AWCButton(pc,AWCKind(body)=="party"?"Companion inventory":"Recoverable satchel","inventory",AWCHas(allowed,"inventory")));
 if(AWCKind(body)=="party")rows=JsonArrayInsert(rows,AWCButton(pc,"Leave my party","dismiss"));else rows=JsonArrayInsert(rows,AWCLabel("Use the normal game menu to dismiss this familiar or summon."));}
 int live=AWInt(AWCCfg(),"live_ai") && AWInt(policy,"ai_enabled");rows=JsonArrayInsert(rows,AWCButton(pc,"AI conversation: "+(AWInt(record,"ai")?"on":"off"),"toggle_ai",live));
 rows=JsonArrayInsert(rows,AWCButton(pc,"AI movement: "+(AWInt(record,"movement")?"on":"off"),"toggle_move",AWInt(policy,"movement")));rows=JsonArrayInsert(rows,AWCButton(pc,"Inventory permission: "+(AWInt(record,"inventory")?"on":"off"),"toggle_pack",AWInt(policy,"inventory")));
 json lengths=JsonParse("[\"Brief\",\"Natural\",\"Detailed\"]");json tones=JsonParse("[\"Character default\",\"Warm\",\"Playful\",\"Reserved\",\"Serious\"]");json style=JsonArray();style=JsonArrayInsert(style,AWCButton(pc,"Reply: "+JsonGetString(JsonArrayGet(lengths,AWInt(record,"reply"))),"reply"));style=JsonArrayInsert(style,AWCButton(pc,"Tone: "+JsonGetString(JsonArrayGet(tones,AWInt(record,"tone"))),"tone"));rows=JsonArrayInsert(rows,AWUIRow(style));
 rows=JsonArrayInsert(rows,AWCButton(pc,"Talk freely with AI","chat",live && AWInt(record,"ai")));rows=JsonArrayInsert(rows,AWCButton(pc,"Back to companions","back"));AWCUILaunch(pc,rows,"Companion controls",AWCOwner(body)==pc?10:9,"control");}
int AWCPackOwned(object pc,object pack){return GetIsObjectValid(pack) && GetObjectType(pack)==OBJECT_TYPE_ITEM && GetHasInventory(pack) && GetItemPossessor(pack,TRUE)==pc && GetLocalString(pack,"AWC_PACK_WORLD")==AWCWorld() && GetLocalString(pack,"AWC_PACK_ID")!="";}
int AWCItemSafe(object item,object holder){if(!GetIsObjectValid(item) || GetItemPossessor(item,TRUE)!=holder || GetPlotFlag(item) || GetItemCursedFlag(item) || !GetDroppableFlag(item) || !GetIdentified(item) || GetHasInventory(item) || GetGoldPieceValue(item)>5000)return FALSE;
 if(GetObjectType(holder)==OBJECT_TYPE_CREATURE){int slot=0;while(slot<18){if(GetItemInSlot(slot,holder)==item)return FALSE;slot++;}}return TRUE;}
int AWCManualControl(object pc){json actors=AWCActors(pc);int i=0;while(i<JsonGetLength(actors)){object body=GetObjectByUUID(JsonGetString(JsonArrayGet(actors,i)));if(GetIsPC(body) || GetIsPossessedFamiliar(body) || GetIsDMPossessed(body))return TRUE;i++;}return FALSE;}
int AWCPackReady(object pc,object storage){if(!GetIsPC(pc) || GetIsDead(pc) || GetIsInCombat(pc) || GetIsDMPossessed(pc) || AWCManualControl(pc))return FALSE;if(AWCPackOwned(pc,storage))return TRUE;
 if(!AWCReady(pc,storage) || AWCKind(storage)!="party")return FALSE;json p=AWCPolicy(storage);json r=AWCRecord(pc,AWCIdentity(pc,storage));return AWInt(p,"inventory") && AWInt(r,"inventory");}
void AWCOpenRecover(object pc){json rows=JsonArray();rows=JsonArrayInsert(rows,AWCLabel("These satchels remain yours after a familiar or summon disappears."));object bag=GetFirstItemInInventory(pc);int count=0;int scanned=0;
 while(GetIsObjectValid(bag) && scanned<2048 && count<8){if(AWCPackOwned(pc,bag)){SetLocalObject(pc,"AWC_PACK_ROW_"+IntToString(count),bag);rows=JsonArrayInsert(rows,AWCButton(pc,GetName(bag),"bag"+IntToString(count)));count++;}bag=GetNextItemInInventory(pc);scanned++;}
 if(count==0)rows=JsonArrayInsert(rows,AWCLabel("No satchels yet. Open a familiar's or summon's inventory to create one."));SetLocalInt(pc,"AWC_PACK_ROWS",count);rows=JsonArrayInsert(rows,AWCLabel("All satchels can also be opened in your normal inventory."));rows=JsonArrayInsert(rows,AWCButton(pc,"Back","back"));AWCUILaunch(pc,rows,"Recover satchels",count+3,"recover");}
void AWCOpenPack(object pc,object storage){if(!AWCPackReady(pc,storage)){SendMessageToPC(pc,"Inventory access requires ownership, permission and no combat.");return;}SetLocalObject(pc,"AWC_STORAGE",storage);int giving=GetLocalInt(pc,"AWC_GIVING");object holder=giving?pc:storage;int page=GetLocalInt(pc,"AWC_PACK_PAGE");json rows=JsonArray();rows=JsonArrayInsert(rows,AWCLabel(GetName(storage)+" | "+(giving?"Giving from your inventory":"Taking from companion storage")));
 rows=JsonArrayInsert(rows,AWCLabel("Each click transfers the selected whole item or stack through the game."));object item=GetFirstItemInInventory(holder);int skipped=0;int shown=0;int scanned=0;int extra=FALSE;
 while(GetIsObjectValid(item) && scanned<2048){if(AWCItemSafe(item,holder)){if(skipped<page*8)skipped++;else if(shown<8){SetLocalObject(pc,"AWC_ITEM_"+IntToString(shown),item);rows=JsonArrayInsert(rows,AWCButton(pc,(giving?"Give ":"Take ")+GetName(item)+" x"+IntToString(GetItemStackSize(item)),"item"+IntToString(shown),!GetLocalInt(pc,"AWC_TRANSFER_PENDING")));shown++;}else {extra=TRUE;break;}}item=GetNextItemInInventory(holder);scanned++;}
 SetLocalInt(pc,"AWC_ITEMS",shown);if(!shown)rows=JsonArrayInsert(rows,AWCLabel("No eligible items on this page. Equipped/plot/cursed/bag items are excluded."));
 json nav=JsonArray();nav=JsonArrayInsert(nav,AWCButton(pc,"Previous","pack_previous",page>0));nav=JsonArrayInsert(nav,AWCButton(pc,"Next","pack_next",extra));nav=JsonArrayInsert(nav,AWCButton(pc,giving?"Show companion items":"Show your items","pack_side"));rows=JsonArrayInsert(rows,AWUIRow(nav));rows=JsonArrayInsert(rows,AWCButton(pc,"Refresh","pack_refresh"));if(AWCPackOwned(pc,storage) && !GetIsObjectValid(GetFirstItemInInventory(storage)))rows=JsonArrayInsert(rows,AWCButton(pc,"Discard this empty satchel","discard_empty",!GetLocalInt(pc,"AWC_TRANSFER_PENDING")));rows=JsonArrayInsert(rows,AWCButton(pc,"Back","back"));AWCUILaunch(pc,rows,"Companion inventory",shown+5,"pack");}
void AWCInventory(object pc,object body){if(!AWCReady(pc,body) || !AWCObserve(pc,body))return;json record=AWCRecord(pc,AWCIdentity(pc,body));if(!AWCHas(AWCAllowed(pc,body,record),"inventory"))return;object storage=body;
 if(AWCKind(body)!="party")storage=AWCSatchel(pc,AWCIdentity(pc,body),GetName(body),TRUE);if(!GetIsObjectValid(storage)){SendMessageToPC(pc,"The satchel is unavailable. Check your normal inventory; no replacement was created.");return;}
 SetLocalInt(pc,"AWC_PACK_PAGE",0);SetLocalInt(pc,"AWC_GIVING",FALSE);AWCOpenPack(pc,storage);}
void AWCApply(object pc,object body,string command){if(command=="inventory")AWCInventory(pc,body);else AWCOrder(pc,body,command);}
object AWCByAlias(object pc,string name){object body=AWCFind(pc,name);if(GetLocalInt(pc,"AWC_AMBIGUOUS"))return OBJECT_INVALID;json npcs=AWCompanionNPCs();int i=0;while(i<JsonGetLength(npcs)){json n=JsonArrayGet(npcs,i);if(name==AWText(n,"alias") || name==GetStringLowerCase(AWText(n,"name"))){object candidate=GetObjectByTag(AWText(n,"id"));if(GetIsObjectValid(body) && body!=candidate){SetLocalInt(pc,"AWC_AMBIGUOUS",TRUE);return OBJECT_INVALID;}body=candidate;}i++;}return body;}
int AWCChatControl(object pc,string s){DeleteLocalObject(pc,"AWC_CHAT_TARGET");DeleteLocalString(pc,"AWC_CHAT_TEXT");if(s=="!companions" || s=="!companion"){AWCOpenList(pc);return TRUE;}
 string rest=GetSubString(s,11,1300);string lower=GetStringLowerCase(rest);if(lower=="recover"){AWCOpenRecover(pc);return TRUE;}
 object body=GetLocalObject(pc,"SP_FOCUS");if(AWText(AWCPolicy(body),"id")=="")body=OBJECT_INVALID;
 int at=FindSubString(rest," ");string first=GetStringLowerCase(at<0?rest:GetStringLeft(rest,at));object addressed=AWCByAlias(pc,first);
 if(GetLocalInt(pc,"AWC_AMBIGUOUS")){SendMessageToPC(pc,"That companion name is ambiguous. Select the exact actor in !companions.");return TRUE;}
 if(GetIsObjectValid(addressed)){body=addressed;rest=at<0?"settings":GetSubString(rest,at+1,1200);lower=GetStringLowerCase(rest);}
 else if(first=="familiar" || GetStringLeft(first,6)=="summon"){SendMessageToPC(pc,"That companion is unavailable. Select a current actor in !companions.");return TRUE;}
 if(!GetIsObjectValid(body)){json owned=AWCActors(pc);if(JsonGetLength(owned)==1)body=GetObjectByUUID(JsonGetString(JsonArrayGet(owned,0)));}
 if(!GetIsObjectValid(body)){AWCOpenList(pc);SendMessageToPC(pc,"Select a companion before giving commands or starting a conversation.");return TRUE;}
 if(lower=="settings" || lower=="menu"){AWCOpenControl(pc,body);return TRUE;}
 if(lower=="on" || lower=="off"){if(AWCReady(pc,body,FALSE) && AWCObserve(pc,body)){AWCSet(pc,AWCIdentity(pc,body),"ai",lower=="on");SendMessageToPC(pc,"Companion AI preference updated. Creator permissions still apply.");}return TRUE;}
 string command="";if(lower=="follow" || lower=="follow me")command="follow";if(lower=="stay" || lower=="stay here" || lower=="stand ground")command="stay";if(lower=="guard" || lower=="guard me")command="guard";if(lower=="inventory")command="inventory";if(lower=="recruit" || lower=="join me")command="recruit";if(lower=="dismiss")command="dismiss";
 if(command!=""){AWCApply(pc,body,command);return TRUE;}
 SetLocalObject(pc,"AWC_CHAT_TARGET",body);SetLocalString(pc,"AWC_CHAT_TEXT",rest);return FALSE;}
int AWCCount(object holder,string tag,string resref){int count=0;object item=GetFirstItemInInventory(holder);int scanned=0;while(GetIsObjectValid(item) && scanned<2048){if(GetTag(item)==tag && GetResRef(item)==resref)count+=GetItemStackSize(item);item=GetNextItemInInventory(holder);scanned++;}return count;}
void AWCTransfer(object pc,object storage,object item){if(!AWCPackReady(pc,storage))return;object from=GetLocalInt(pc,"AWC_GIVING")?pc:storage;object to=GetLocalInt(pc,"AWC_GIVING")?storage:pc;
 if(!AWCItemSafe(item,from) || GetLocalInt(pc,"AWC_TRANSFER_PENDING")){SendMessageToPC(pc,"That item changed or a native transfer is still pending. Refresh inventory.");return;}
 SetLocalObject(pc,"AWC_TRANSFER_ITEM",item);SetLocalObject(pc,"AWC_TRANSFER_STORAGE",storage);SetLocalObject(pc,"AWC_TRANSFER_FROM",from);SetLocalObject(pc,"AWC_TRANSFER_TO",to);SetLocalInt(pc,"AWC_TRANSFER_EXP",AWMClock()+30);SetLocalString(pc,"AWC_TRANSFER_TAG",GetTag(item));SetLocalString(pc,"AWC_TRANSFER_RES",GetResRef(item));SetLocalInt(pc,"AWC_TRANSFER_COUNT",GetItemStackSize(item));SetLocalInt(pc,"AWC_TRANSFER_BEFORE",AWCCount(to,GetTag(item),GetResRef(item)));SetLocalInt(pc,"AWC_TRANSFER_PENDING",TRUE);
 SetLocalInt(pc,"AWC_TRANSFER_SOURCE_COUNT",AWCCount(from,GetTag(item),GetResRef(item)));SetLocalString(pc,"AWC_TRANSFER_ID",GetObjectType(storage)==OBJECT_TYPE_ITEM?GetLocalString(storage,"AWC_PACK_ID"):AWCIdentity(pc,storage));
 // This explicit owner click replaces only the owner action queue. NPC follow/combat scripts remain untouched.
 AssignCommand(pc,ClearAllActions(TRUE));if(from==pc)AssignCommand(pc,ActionGiveItem(item,to));else AssignCommand(pc,ActionTakeItem(item,from));
 SendMessageToPC(pc,"Native transfer requested. Check the game confirmation and inventories.");AWCUIClose(pc);}
void AWCTransferTick(object pc){if(!GetLocalInt(pc,"AWC_TRANSFER_PENDING"))return;object item=GetLocalObject(pc,"AWC_TRANSFER_ITEM");object to=GetLocalObject(pc,"AWC_TRANSFER_TO");object from=GetLocalObject(pc,"AWC_TRANSFER_FROM");object storage=GetLocalObject(pc,"AWC_TRANSFER_STORAGE");
 int merged=!GetIsObjectValid(item) && AWCCount(to,GetLocalString(pc,"AWC_TRANSFER_TAG"),GetLocalString(pc,"AWC_TRANSFER_RES"))>=GetLocalInt(pc,"AWC_TRANSFER_BEFORE")+GetLocalInt(pc,"AWC_TRANSFER_COUNT") && AWCCount(from,GetLocalString(pc,"AWC_TRANSFER_TAG"),GetLocalString(pc,"AWC_TRANSFER_RES"))<=GetLocalInt(pc,"AWC_TRANSFER_SOURCE_COUNT")-GetLocalInt(pc,"AWC_TRANSFER_COUNT");
 if((GetIsObjectValid(item) && GetItemPossessor(item,TRUE)==to) || merged){DeleteLocalInt(pc,"AWC_TRANSFER_PENDING");DeleteLocalObject(pc,"AWC_TRANSFER_ITEM");AWCReceipt(pc,GetLocalString(pc,"AWC_TRANSFER_ID"),"Native game inventory confirmed the requested transfer.");SendMessageToPC(pc,"COMPANION TRANSFER CONFIRMED by native inventory.");return;}
 if(AWMClock()>=GetLocalInt(pc,"AWC_TRANSFER_EXP") || !AWCPackReady(pc,storage)){DeleteLocalInt(pc,"AWC_TRANSFER_PENDING");DeleteLocalObject(pc,"AWC_TRANSFER_ITEM");SendMessageToPC(pc,"Transfer not confirmed. Inspect both inventories; nothing will be recreated or retried automatically.");}}
