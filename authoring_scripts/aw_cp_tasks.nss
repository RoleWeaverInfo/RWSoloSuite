// Owner-directed inspect/visit/return tasks. Actual objects, native movement and verified whole-stack transfers.
#include "aw_companion"
int AWTOwned(object pc,object body){return GetIsPC(pc) && GetIsObjectValid(body) && AWCOwner(body)==pc && AWCLinked(body);}
int AWTControlled(object body){return GetIsPC(body) || GetIsDMPossessed(body) || GetIsPossessedFamiliar(body) || !GetCommandable(body);}
int AWTBase(object pc,object body){return AWTOwned(pc,body) && !GetIsDead(pc) && !GetIsDead(body) && !AWTControlled(body) && !GetIsInCombat(pc) && !GetIsInCombat(body) && !IsInConversation(pc) && !IsInConversation(body) && GetArea(pc)==GetArea(body);}
int AWTPermitted(object pc,object body,string kind){json p=AWCPolicy(body);json r=AWCRecord(pc,AWCIdentity(pc,body));if(!AWInt(p,"movement") || !AWInt(r,"movement"))return FALSE;
 if(kind=="take" || kind=="put")return AWInt(p,"inspect_containers") && AWInt(p,"inventory") && AWInt(r,"inventory");
 if(kind=="inspect")return AWInt(p,"inspect_containers");return AWInt(p,"social_visits") && AWInt(p,"ai_enabled") && AWInt(r,"ai") && AWInt(AWCCfg(),"live_ai") && AWCMode(body)=="speech";}
int AWTChest(object body,object target){return GetIsObjectValid(target) && GetObjectType(target)==OBJECT_TYPE_PLACEABLE && GetHasInventory(target) && !GetIsObjectValid(GetLocalObject(target,"AWP_OWNER")) && GetArea(body)==GetArea(target) && GetDistanceBetween(body,target)<=45.0 && LineOfSightObject(body,target) && AQDone(GetLocalString(target,"AW_GATE")) && !GetLocked(target) && !GetIsTrapped(target);}
int AWTRecipient(object body,object target){json p=AWFind(AWABehaviors(),GetTag(target));return GetIsObjectValid(target) && target!=body && GetObjectType(target)==OBJECT_TYPE_CREATURE && !GetIsPC(target) && !GetIsDead(target) && !GetIsDMPossessed(target) && !GetIsObjectValid(GetMaster(target)) && GetCommandable(target) && !GetIsInCombat(target) && !IsInConversation(target) && GetArea(body)==GetArea(target) && GetDistanceBetween(body,target)<=45.0 && LineOfSightObject(body,target) && GetObjectSeen(target,body) && AWInt(p,"accept_visits") && AWInt(p,"ai_enabled") && GetResRef(target)==AWText(p,"id") && (GetLocalString(target,"AWA_VISIT_LOCK")=="" || GetLocalString(target,"AWA_VISIT_LOCK")==GetObjectUUID(body));}
json AWTCandidates(object pc,object body){json out=JsonArray();if(!AWTBase(pc,body) || GetLocalInt(body,"AWT_ACTIVE"))return out;int inspect=AWTPermitted(pc,body,"inspect");int visit=AWTPermitted(pc,body,"visit");if(!inspect && !visit)return out;
 object target=GetFirstObjectInArea(GetArea(body));int scan=0;while(GetIsObjectValid(target) && scan<128 && JsonGetLength(out)<16){string kind="";if(inspect && AWTChest(body,target))kind="inspect";else if(visit && AWTRecipient(body,target))kind="visit";
 if(kind!=""){json row=JsonObject();row=JsonObjectSet(row,"kind",JsonString(kind));row=JsonObjectSet(row,"uuid",JsonString(GetObjectUUID(target)));row=JsonObjectSet(row,"tag",JsonString(GetTag(target)));row=JsonObjectSet(row,"name",JsonString(GetStringLeft(GetName(target),100)));row=JsonObjectSet(row,"distance",JsonInt(FloatToInt(GetDistanceBetween(body,target))));out=JsonArrayInsert(out,row);if(kind=="inspect" && AWTPermitted(pc,body,"take")){out=JsonArrayInsert(out,JsonObjectSet(row,"kind",JsonString("take")));out=JsonArrayInsert(out,JsonObjectSet(row,"kind",JsonString("put")));}}target=GetNextObjectInArea(GetArea(body));scan++;}return out;}
void AWTMove(object body,string op,object dest=OBJECT_INVALID){SetLocalString(body,"AWT_MOVE_OP",op);SetLocalObject(body,"AWT_DEST",dest);ExecuteScript("aw_ct_move",body);}
void AWTFinish(object pc,object body,string reason){if(GetStringLeft(reason,18)!="Reported to owner:"){if(GetIsObjectValid(body) && GetDistanceBetween(pc,body)<=12.0 && AWCMode(body)=="speech")AssignCommand(body,SpeakString(reason,TALKVOLUME_TALK));else SendMessageToPC(pc,GetName(body)+": "+reason);}object target=GetLocalObject(body,"AWT_TARGET");if(GetLocalString(target,"AWA_VISIT_LOCK")==GetObjectUUID(body))DeleteLocalString(target,"AWA_VISIT_LOCK");
 if(GetLocalString(body,"AWT_REQUEST")!="" && AWInt(AWCCfg(),"live_ai"))ExecuteScript("aw_ct_cancel",body);DeleteLocalInt(body,"AWT_ACTIVE");SetLocalString(body,"AWT_STATUS",reason);AWCReceipt(pc,AWCIdentity(pc,body),reason);SetLocalInt(body,"AWT_RESTORE",TRUE);}
void AWTCancel(object pc,object body){if(!AWTOwned(pc,body))return;if(!GetLocalInt(body,"AWT_ACTIVE")){SendMessageToPC(pc,"No active task for "+GetName(body)+".");return;}AWTFinish(pc,body,"Task cancelled by the owner.");SendMessageToPC(pc,GetName(body)+": task cancelled. Newer native orders take priority.");}
void AWTStatus(object pc,object body){if(AWTOwned(pc,body))SendMessageToPC(pc,GetName(body)+": "+(GetLocalString(body,"AWT_STATUS")==""?"No task yet.":GetLocalString(body,"AWT_STATUS")));}
void AWTStart(object pc,object body,string kind,object target,string question){if(!AWCReady(pc,body) || !AWCObserve(pc,body) || !AWTBase(pc,body) || !AWTPermitted(pc,body,kind)){SendMessageToPC(pc,"That task requires an available owned companion and creator/player permission. Verbal visits need AI and a speaking profile.");return;}
 object previous=GetLocalObject(pc,"AWT_ACTOR");if(GetLocalString(pc,"AWT_ACTOR_UUID")!="" && (!GetIsObjectValid(previous) || GetLocalInt(previous,"AWT_ACTIVE") || GetLocalInt(previous,"AWT_RESTORE"))){SendMessageToPC(pc,"Finish or cancel the current companion task first.");return;}json owned=AWCActors(pc);int i=0;while(i<JsonGetLength(owned)){if(GetLocalInt(GetObjectByUUID(JsonGetString(JsonArrayGet(owned,i))),"AWT_ACTIVE")){SendMessageToPC(pc,"Finish or cancel the current companion task first.");return;}i++;}
 if((kind!="visit" && !AWTChest(body,target)) || (kind=="visit" && !AWTRecipient(body,target))){SendMessageToPC(pc,"That target is unavailable, inaccessible or not permitted for this task.");return;}
 SetLocalObject(body,"AWT_OWNER",pc);SetLocalObject(body,"AWT_TARGET",target);SetLocalString(body,"AWT_TARGET_UUID",GetObjectUUID(target));SetLocalString(body,"AWT_KIND",kind);SetLocalString(body,"AWT_QUESTION",GetStringLeft(question,600));DeleteLocalString(body,"AWT_REQUEST");DeleteLocalString(body,"AWT_RESULT");SetLocalInt(body,"AWC_CONTROL_EPOCH",GetLocalInt(body,"AWC_CONTROL_EPOCH")+1);SetLocalInt(body,"AWT_EPOCH",GetLocalInt(body,"AWC_CONTROL_EPOCH"));SetLocalInt(body,"AWT_NATIVE",GetLastAssociateCommand(body));SetLocalInt(body,"AWT_SAVE_EPOCH",AWInt(AWCRecord(pc,AWCIdentity(pc,body)),"epoch"));DeleteLocalInt(body,"AWT_MOVE_OK");AWTMove(body,"start");
 if(!GetLocalInt(body,"AWT_MOVE_OK")){SendMessageToPC(pc,"The native associate could not accept that task.");return;}SetLocalObject(pc,"AWT_ACTOR",body);SetLocalObject(pc,"AWT_TARGET",target);SetLocalString(pc,"AWT_ACTOR_UUID",GetObjectUUID(body));SetLocalInt(body,"AWT_ACTIVE",TRUE);SetLocalInt(body,"AWT_PHASE",1);SetLocalInt(body,"AWT_EXPIRES",AWMClock()+240);SetLocalString(body,"AWT_STATUS","Travelling to "+GetName(target));AWCReceipt(pc,AWCIdentity(pc,body),"I have set off, but have not learned anything yet.");AWTMove(body,"move",target);SendMessageToPC(pc,GetName(body)+": task started. Use !companion <alias/slot> status or cancel.");}
int AWTApplyAI(object pc,object body,json result){string choice=AWText(result,"task_target");if(choice=="")return FALSE;
 string offered=GetLocalString(pc,"AWT_PENDING_OPTIONS");DeleteLocalString(pc,"AWT_PENDING_OPTIONS");if(offered=="" || !AWTOwned(pc,body) || GetLocalInt(body,"AWT_ACTIVE")){SendMessageToPC(pc,"The companion task offer expired; ask again.");return TRUE;}
 json options=JsonParse(offered);int i=0;while(i<JsonGetLength(options)){json entry=JsonArrayGet(options,i);string kind=AWText(entry,"kind");if(choice==kind+":"+AWText(entry,"uuid")){
 object target=GetObjectByUUID(AWText(entry,"uuid"));string question=GetStringLeft(AWText(result,"task_question"),600);if(kind=="visit" && question==""){SendMessageToPC(pc,"No question was supplied; no task started.");return TRUE;}
 if(kind=="inspect" || kind=="visit" || kind=="take" || kind=="put"){SetLocalString(body,"AWT_ITEM_QUERY",GetStringLeft(AWText(result,"task_item"),100));SetLocalString(body,"AWT_QUANTITY",AWText(result,"task_quantity"));AWTStart(pc,body,kind,target,question);}return TRUE;}i++;}SendMessageToPC(pc,"That target was not offered by the game; no task started.");return TRUE;}
void AWTInspectResult(object body,object target){string result="When I inspected "+GetName(target)+", I found: ";object item=GetFirstItemInInventory(target);int scan=0;int count=0;while(GetIsObjectValid(item) && scan<128 && count<16 && GetStringLength(result)<700){if(GetItemPossessor(item,TRUE)==target){if(count>0)result+="; ";result+=(GetIdentified(item)?GetStringLeft(GetName(item),80):"an unidentified item")+" x"+IntToString(GetItemStackSize(item));count++;}item=GetNextItemInInventory(target);scan++;}if(count==0)result+="no items";if(GetIsObjectValid(item))result+="; additional items not listed";SetLocalString(body,"AWT_RESULT",GetStringLeft(result,2000)+". I did not take anything.");SetLocalInt(body,"AWT_PHASE",4);SetLocalString(body,"AWT_STATUS","Inspection confirmed; returning to owner.");}
void AWTBodyTick(object pc,object body){if(GetLocalInt(body,"AWT_RESTORE")){if(GetLocalInt(body,"AWT_EPOCH")!=GetLocalInt(body,"AWC_CONTROL_EPOCH") || GetLocalInt(body,"AWT_NATIVE")!=GetLastAssociateCommand(body) || !AWTOwned(pc,body)){DeleteLocalInt(body,"AWT_RESTORE");DeleteLocalInt(body,"AWT_LEASE");}else if(!AWTControlled(body) && !GetIsDead(body)){AWTMove(body,"restore");if(!GetLocalInt(body,"AWT_LEASE"))DeleteLocalInt(body,"AWT_RESTORE");}}
 if(!GetLocalInt(body,"AWT_ACTIVE"))return;string kind=GetLocalString(body,"AWT_KIND");if(!AWTBase(pc,body) || !AWTPermitted(pc,body,kind) || AWMClock()>=GetLocalInt(body,"AWT_EXPIRES") || GetLocalInt(body,"AWT_EPOCH")!=GetLocalInt(body,"AWC_CONTROL_EPOCH") || GetLocalInt(body,"AWT_NATIVE")!=GetLastAssociateCommand(body) || GetLocalInt(body,"AWT_SAVE_EPOCH")!=AWInt(AWCRecord(pc,AWCIdentity(pc,body)),"epoch")){AWTFinish(pc,body,"I had to stop when our circumstances changed; I have not completed your request.");SendMessageToPC(pc,GetName(body)+": task stopped. No success is assumed.");return;}
 int phase=GetLocalInt(body,"AWT_PHASE");object target=GetLocalObject(body,"AWT_TARGET");if(phase<4 && (!GetIsObjectValid(target) || GetObjectUUID(target)!=GetLocalString(body,"AWT_TARGET_UUID") || (kind!="visit"?!AWTChest(body,target):!AWTRecipient(body,target)))){AWTFinish(pc,body,"I could no longer reach the person or container safely.");return;}
 if(phase==1){float range=kind!="visit"?3.0:6.0;if(GetDistanceBetween(body,target)>range){AWTMove(body,"move",target);return;}if(GetCurrentAction(body)==ACTION_WAIT)AWTMove(body,"pause");if(GetCurrentAction(body)!=ACTION_INVALID)return;
 if(kind=="inspect" || kind=="take" || kind=="put"){DeleteLocalInt(body,"AWT_ACCESS");AWTMove(body,"open",target);if(!GetLocalInt(body,"AWT_ACCESS")){AWTFinish(pc,body,"I could not get close enough to examine the container safely.");return;}if(kind=="inspect")AWTInspectResult(body,target);else ExecuteScript("aw_ct_transfer",body);return;}
 if(GetCurrentAction(target)!=ACTION_INVALID)return;SetLocalString(target,"AWA_VISIT_LOCK",GetObjectUUID(body));SetLocalInt(body,"AWT_TARGET_EPOCH",GetLocalInt(target,"AWA_EPOCH"));SetLocalInt(body,"AWT_PHASE",3);AssignCommand(body,SpeakString(GetLocalString(body,"AWT_QUESTION"),TALKVOLUME_TALK));ExecuteScript("aw_ct_request",body);return;}

 if(phase==5){ExecuteScript("aw_ct_transfer",body);return;}
 if(phase==3){if(GetLocalInt(body,"AWT_TARGET_EPOCH")!=GetLocalInt(target,"AWA_EPOCH") || GetDistanceBetween(body,target)>6.0 || GetLocalString(target,"AWA_VISIT_LOCK")!=GetObjectUUID(body)){AWTFinish(pc,body,"Visit interrupted before an answer was delivered.");return;}ExecuteScript("aw_ct_poll",body);return;}
 if(phase==4){if(GetDistanceBetween(pc,body)>5.0 || !LineOfSightObject(pc,body)){AWTMove(body,"move",pc);return;}string result=GetLocalString(body,"AWT_RESULT");if(result==""){AWTFinish(pc,body,"I have nothing certain to report.");return;}
 if(AWCMode(body)=="speech")AssignCommand(body,SpeakString(result,TALKVOLUME_TALK));else {AssignCommand(body,SpeakString("*Returns and gestures toward the inspected container.*",TALKVOLUME_TALK));SendMessageToPC(pc,"Observed by "+GetName(body)+": "+result);}
 AWCHistorySet(pc,body,AWText(AWCRecord(pc,AWCIdentity(pc,body)),"history")+"\nOwner-directed task report: "+result);AWTFinish(pc,body,"Reported to owner: "+result);SetLocalString(body,"AWT_STATUS","Task complete; report delivered.");}}
void AWTTick(object pc){if(!GetLocalInt(pc,"AWX_PHASE") && GetLocalInt(pc,"AWT_TRANSFER_PENDING") && AWMClock()>=GetLocalInt(pc,"AWT_TRANSFER_EXPIRES"))DeleteLocalInt(pc,"AWT_TRANSFER_PENDING");object active=GetLocalObject(pc,"AWT_ACTOR");if(GetLocalString(pc,"AWT_ACTOR_UUID")!=""){
 if(!GetIsObjectValid(active)){object target=GetLocalObject(pc,"AWT_TARGET");if(GetLocalString(target,"AWA_VISIT_LOCK")==GetLocalString(pc,"AWT_ACTOR_UUID"))DeleteLocalString(target,"AWA_VISIT_LOCK");if(AWInt(AWCCfg(),"live_ai"))ExecuteScript("aw_ct_cancel",pc);DeleteLocalString(pc,"AWT_ACTOR_UUID");SendMessageToPC(pc,"The tasked companion disappeared. Its task was stopped; no result is assumed.");}
 else {AWTBodyTick(pc,active);if(!GetLocalInt(active,"AWT_ACTIVE") && !GetLocalInt(active,"AWT_RESTORE"))DeleteLocalString(pc,"AWT_ACTOR_UUID");}}
 json actors=AWCActors(pc);int i=0;while(i<JsonGetLength(actors)){AWTBodyTick(pc,GetObjectByUUID(JsonGetString(JsonArrayGet(actors,i))));i++;}}
int AWTParse(object pc,object body,string text){if(!AWTOwned(pc,body))return FALSE;string own=GetStringLowerCase(GetName(body));string lower=GetStringLowerCase(text);int separator=FindSubString(text,",");if(separator<0)separator=FindSubString(text,".");if(separator<0)separator=FindSubString(text,":");if(separator>0 && GetStringLeft(lower,separator)==own){text=GetSubString(text,separator+1,1200);while(GetStringLeft(text,1)==" ")text=GetSubString(text,1,1200);}lower=GetStringLowerCase(text);if(GetStringLeft(lower,7)=="please ")text=GetSubString(text,7,1200);lower=GetStringLowerCase(text);if(GetStringLeft(lower,8)=="can you ")text=GetSubString(text,8,1200);lower=GetStringLowerCase(text);if(GetStringLeft(lower,10)=="could you ")text=GetSubString(text,10,1200);lower=GetStringLowerCase(text);if(GetStringLeft(lower,3)=="go ")text=GetSubString(text,3,1200);lower=GetStringLowerCase(text);if(lower=="cancel" || lower=="cancel task"){AWTCancel(pc,body);return TRUE;}if(lower=="status" || lower=="task status"){AWTStatus(pc,body);return TRUE;}
 string rest="";string kind="";if(GetStringLeft(lower,8)=="inspect "){kind="inspect";rest=GetSubString(text,8,700);}else if(GetStringLeft(lower,6)=="check "){kind="inspect";rest=GetSubString(text,6,700);}else if(GetStringLeft(lower,12)=="look inside "){kind="inspect";rest=GetSubString(text,12,700);}else if(GetStringLeft(lower,4)=="ask "){kind="visit";rest=GetSubString(text,4,1200);}else if(GetStringLeft(lower,3)=="to " && FindSubString(lower," and ask ")>3){kind="visit";rest=GetSubString(text,3,1200);}else if(GetStringLeft(lower,8)=="talk to "){kind="visit";rest=GetSubString(text,8,1200);}else return FALSE;
 string name=GetStringLowerCase(rest);string question="How can you help us?";if(kind=="visit"){int at=FindSubString(rest," ");name=GetStringLowerCase(at<0?rest:GetStringLeft(rest,at));if(at>=0)question=GetSubString(rest,at+1,600);if(GetStringLeft(GetStringLowerCase(question),8)=="and ask ")question=GetSubString(question,8,600);if(GetStringLeft(GetStringLowerCase(question),4)=="him " || GetStringLeft(GetStringLowerCase(question),4)=="her ")question=GetSubString(question,4,600);if(GetStringLeft(GetStringLowerCase(question),5)=="them ")question=GetSubString(question,5,600);if(GetStringLeft(GetStringLowerCase(question),15)=="and report back")question="How can you help us?";}
 object found=OBJECT_INVALID;int count=0;object target=GetFirstObjectInArea(GetArea(body));int scan=0;while(GetIsObjectValid(target) && scan<128){int match=FALSE;if(kind=="inspect" && AWTChest(body,target)){string n=GetStringLowerCase(GetName(target));match=name==n || name==GetStringLowerCase(GetTag(target)) || name=="chest" || name=="the chest" || name=="nearby chest" || name=="the nearby chest" || name=="what is in the nearby chest" || name=="what is in the chest";}
 if(kind=="visit" && AWTRecipient(body,target)){json p=AWFind(AWABehaviors(),GetTag(target));match=name==GetStringLowerCase(GetTag(target)) || name==GetStringLowerCase(GetName(target)) || name==AWText(p,"alias");}
 if(match){found=target;count++;}target=GetNextObjectInArea(GetArea(body));scan++;}if(count!=1){if(AWInt(AWCCfg(),"live_ai") && AWInt(AWCPolicy(body),"ai_enabled") && AWInt(AWCRecord(pc,AWCIdentity(pc,body)),"ai"))return FALSE;SendMessageToPC(pc,count>1?"That task target is ambiguous. Use the exact container name or NPC alias.":"No visible permitted target matches. Use the companion task menu to see available targets.");return TRUE;}AWTStart(pc,body,kind,found,question);return TRUE;}
