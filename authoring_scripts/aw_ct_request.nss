#include "sp_inc"
void main(){object pc=GetLocalObject(OBJECT_SELF,"AWT_OWNER");object target=GetLocalObject(OBJECT_SELF,"AWT_TARGET");if(!AWTBase(pc,OBJECT_SELF) || !AWTRecipient(OBJECT_SELF,target) || GetLocalInt(OBJECT_SELF,"AWT_PHASE")!=3)return;
 json source=JsonObject();source=JsonObjectSet(source,"kind",JsonString(AWCKind(OBJECT_SELF)));source=JsonObjectSet(source,"profile",JsonString(AWText(AWCPolicy(OBJECT_SELF),"id")));source=JsonObjectSet(source,"name",JsonString(GetName(OBJECT_SELF)));source=JsonObjectSet(source,"resref",JsonString(GetResRef(OBJECT_SELF)));source=JsonObjectSet(source,"familiar_type",JsonInt(AWCKind(OBJECT_SELF)=="familiar"?GetFamiliarCreatureType(GetMaster()):-1));source=JsonObjectSet(source,"communication",JsonString(AWCMode(OBJECT_SELF)));
 json payload=JsonObject();payload=JsonObjectSet(payload,"source",source);payload=JsonObjectSet(payload,"target",JsonString(GetTag(target)));payload=JsonObjectSet(payload,"actor_uuid",JsonString(GetObjectUUID(OBJECT_SELF)));payload=JsonObjectSet(payload,"owner_uuid",JsonString(GetObjectUUID(pc)));payload=JsonObjectSet(payload,"target_uuid",JsonString(GetObjectUUID(target)));payload=JsonObjectSet(payload,"question",JsonString(GetLocalString(OBJECT_SELF,"AWT_QUESTION")));payload=JsonObjectSet(payload,"quests",AQStates());json observed=JsonObject();json shop=AWMContext(pc,target);if(GetDistanceBetween(OBJECT_SELF,target)<=5.0 && LineOfSightObject(OBJECT_SELF,target))shop=JsonObjectSet(shop,"available",JsonInt(1));observed=JsonObjectSet(observed,"merchant",shop);payload=JsonObjectSet(payload,"game",observed);string id=GetRandomUUID();
 sqlquery q=SqlPrepareQueryCampaign(SPDB,"INSERT INTO sp_requests(request_id,session_id,kind,npc_tag,payload,created,updated) VALUES(@id,@session,'visit','',@payload,CAST(strftime('%s','now') AS INTEGER),CAST(strftime('%s','now') AS INTEGER))");SqlBindString(q,"@id",id);SqlBindString(q,"@session",SPSession());SqlBindString(q,"@payload",JsonDump(payload));SqlStep(q);if(SqlGetError(q)!=""){AWTFinish(pc,OBJECT_SELF,"The visit connection was unavailable; no answer confirmed.");return;}SetLocalString(pc,"AWT_REQUEST",id);SetLocalString(pc,"AWT_SESSION",SPSession());SetLocalString(OBJECT_SELF,"AWT_REQUEST",id);SetLocalString(OBJECT_SELF,"AWT_SESSION",SPSession());SetLocalInt(OBJECT_SELF,"AWT_SENT",SPNow());SetLocalString(OBJECT_SELF,"AWT_STATUS","Question spoken to "+GetName(target)+"; waiting for an answer.");}
