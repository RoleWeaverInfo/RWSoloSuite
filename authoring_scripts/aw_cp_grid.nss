// One canvas keeps press/release coordinates in the same space across both inventories.
#include "nw_inc_nui"
#include "aw_g_icons"
int AWGReady(object pc,object storage){if(!AWCPackReady(pc,storage) || GetLocalInt(pc,"AWX_PHASE") || GetLocalInt(pc,"AWC_TRANSFER_PENDING") || GetLocalInt(pc,"AWT_TRANSFER_PENDING"))return FALSE;object body=GetLocalObject(pc,"AWC_GRID_BODY");if(GetIsObjectValid(body))return AWCReady(pc,body) && AWCHas(AWCAllowed(pc,body,AWCRecord(pc,AWCIdentity(pc,body))),"inventory");return AWCPersistentOwned(pc,storage);}
json AWGItems(object pc,object storage,int side){if(!side)return AWCVisibleItems(pc);json items=AWCVisibleItems(storage);object body=GetLocalObject(pc,"AWC_GRID_BODY");if(GetIsObjectValid(body) && AWCOwner(body)==pc){json gear=AWCVisibleItems(body);int i=0;while(i<JsonGetLength(gear)){string id=JsonGetString(JsonArrayGet(gear,i));if(!AWCHas(items,id))items=JsonArrayInsert(items,JsonString(id));i++;}}return items;}
void AWGSelect(object pc,object item,int side){SetLocalObject(pc,"AWG_SELECTED",item);SetLocalInt(pc,"AWG_SIDE",side);string info="Select an item to see its name and quantity.";if(GetIsObjectValid(item)){object holder=GetItemPossessor(item,TRUE);string lock=AWCItemLock(item,holder);info=GetName(item)+" x"+IntToString(GetItemStackSize(item))+(lock==""?" | Ready to transfer.":" | "+lock);}NuiSetBind(pc,GetLocalInt(pc,"AWC_TOKEN"),"aw_grid_info",JsonString(info));}
json AWGCanvas(object pc,object storage){json draw=JsonArray();int side=0;while(side<2){json items=AWGItems(pc,storage,side);int page=GetLocalInt(pc,"AWG_PAGE_"+IntToString(side));if(page<0 || page*12>=JsonGetLength(items))page=0;SetLocalInt(pc,"AWG_PAGE_"+IntToString(side),page);SetLocalInt(pc,"AWG_TOTAL_"+IntToString(side),JsonGetLength(items));int i=0;while(i<12){float x=10.0+IntToFloat(side*290+(i%4)*70);float y=8.0+IntToFloat((i/4)*98);object item=GetObjectByUUID(JsonGetString(JsonArrayGet(items,page*12+i)));SetLocalObject(pc,"AWG_CELL_"+IntToString(side*12+i),item);
 json color=NuiColor(120,105,75);if(GetIsObjectValid(item) && !AWCItemSafe(item,GetItemPossessor(item,TRUE)))color=NuiColor(120,65,65);draw=JsonArrayInsert(draw,NuiDrawListRect(JsonBool(TRUE),color,JsonBool(FALSE),JsonFloat(1.0),NuiRect(x,y,62.0,90.0)));
 if(GetIsObjectValid(item)){string icon=AWGIcon(GetBaseItemType(item));draw=JsonArrayInsert(draw,NuiDrawListImage(JsonBool(TRUE),JsonString(icon),NuiRect(x+4.0,y+3.0,54.0,51.0),JsonInt(0),JsonInt(0),JsonInt(0)));draw=JsonArrayInsert(draw,NuiDrawListText(JsonBool(TRUE),NuiColor(240,230,205),NuiRect(x+3.0,y+55.0,57.0,32.0),JsonString(GetStringLeft(GetName(item),12)+"\nx"+IntToString(GetItemStackSize(item)))));}i++;}side++;}
 return NuiDrawList(NuiId(NuiImage(JsonString(""),JsonInt(0),JsonInt(0),JsonInt(0)),"aw_grid_canvas"),JsonBool(TRUE),draw);}
void AWCGridOpen(object pc,object storage){if(!AWGReady(pc,storage)){SendMessageToPC(pc,"Inventory is unavailable during combat, an errand or a pending handoff.");return;}SetLocalObject(pc,"AWC_STORAGE",storage);DeleteLocalObject(pc,"AWG_DRAG");DeleteLocalObject(pc,"AWG_SELECTED");json rows=JsonArray();rows=JsonArrayInsert(rows,AWCLabel("YOUR BELONGINGS                         COMPANION BELONGINGS"));rows=JsonArrayInsert(rows,AWUIHeight(AWGCanvas(pc,storage),310.0));rows=JsonArrayInsert(rows,AWUIHeight(NuiText(NuiBind("aw_grid_info"),FALSE,0),42.0));
 json nav=JsonArray();nav=JsonArrayInsert(nav,AWCButton(pc,"Your previous","grid_prev0",GetLocalInt(pc,"AWG_PAGE_0")>0));nav=JsonArrayInsert(nav,AWCButton(pc,"Your next","grid_next0",(GetLocalInt(pc,"AWG_PAGE_0")+1)*12<GetLocalInt(pc,"AWG_TOTAL_0")));nav=JsonArrayInsert(nav,AWCButton(pc,"Their previous","grid_prev1",GetLocalInt(pc,"AWG_PAGE_1")>0));nav=JsonArrayInsert(nav,AWCButton(pc,"Their next","grid_next1",(GetLocalInt(pc,"AWG_PAGE_1")+1)*12<GetLocalInt(pc,"AWG_TOTAL_1")));rows=JsonArrayInsert(rows,AWUIRow(nav));
 json controls=JsonArray();controls=JsonArrayInsert(controls,AWCButton(pc,GetLocalInt(pc,"AWG_ONE")?"Quantity: one":"Quantity: whole stack","grid_quantity"));controls=JsonArrayInsert(controls,AWCButton(pc,"Transfer selected","grid_transfer"));controls=JsonArrayInsert(controls,AWCButton(pc,"Refresh","grid_refresh"));rows=JsonArrayInsert(rows,AWUIRow(controls));rows=JsonArrayInsert(rows,AWCButton(pc,"Close","grid_close"));AWCUILaunch(pc,rows,GetName(storage)+" - companion inventory",14,"grid");NuiSetBind(pc,GetLocalInt(pc,"AWC_TOKEN"),"aw_grid_info",JsonString("Drag an icon to the other side, or select it and click Transfer selected. Red frames mark protected gear."));}
void AWGTransferSelected(object pc){object storage=GetLocalObject(pc,"AWC_STORAGE");object item=GetLocalObject(pc,"AWG_SELECTED");if(!AWGReady(pc,storage) || !GetIsObjectValid(item))return;SetLocalObject(pc,"AWG_REQUEST_ITEM",item);SetLocalInt(pc,"AWG_REQUEST_SIDE",GetLocalInt(pc,"AWG_SIDE"));SetLocalInt(pc,"AWG_REQUEST_ONE",GetLocalInt(pc,"AWG_ONE"));ExecuteScript("aw_cp_give",pc);}
void AWGEvent(object pc){object storage=GetLocalObject(pc,"AWC_STORAGE");string kind=NuiGetEventType();string id=NuiGetEventElement();string suffix="_"+IntToString(GetLocalInt(pc,"AWC_UI_GEN"));if(kind=="click" && id=="grid_close"+suffix){AWCUIClose(pc);return;}if(!AWGReady(pc,storage))return;
 if(kind=="click"){if(id=="grid_transfer"+suffix){AWGTransferSelected(pc);return;}if(id=="grid_quantity"+suffix)SetLocalInt(pc,"AWG_ONE",!GetLocalInt(pc,"AWG_ONE"));else if(id!="grid_refresh"+suffix){int side=0;while(side<2){if(id=="grid_prev"+IntToString(side)+suffix)SetLocalInt(pc,"AWG_PAGE_"+IntToString(side),GetLocalInt(pc,"AWG_PAGE_"+IntToString(side))-1);if(id=="grid_next"+IntToString(side)+suffix)SetLocalInt(pc,"AWG_PAGE_"+IntToString(side),GetLocalInt(pc,"AWG_PAGE_"+IntToString(side))+1);side++;}}AWCGridOpen(pc,storage);return;}
 if(id!="aw_grid_canvas" || (kind!="mousedown" && kind!="mouseup"))return;json payload=NuiGetEventPayload();if(JsonGetInt(JsonObjectGet(payload,"mouse_btn"))!=0)return;json pos=JsonObjectGet(payload,"mouse_pos");float x=JsonGetFloat(JsonObjectGet(pos,"x"));float y=JsonGetFloat(JsonObjectGet(pos,"y"));if(x<0.0 || x>=580.0 || y<0.0 || y>=310.0){DeleteLocalObject(pc,"AWG_DRAG");return;}int side=x>=290.0;int col=FloatToInt((x-IntToFloat(side*290)-10.0)/70.0);int row=FloatToInt((y-8.0)/98.0);
 if(kind=="mousedown"){DeleteLocalObject(pc,"AWG_DRAG");if(col<0 || col>3 || row<0 || row>2)return;object item=GetLocalObject(pc,"AWG_CELL_"+IntToString(side*12+row*4+col));AWGSelect(pc,item,side);if(GetIsObjectValid(item)){SetLocalObject(pc,"AWG_DRAG",item);SetLocalInt(pc,"AWG_DRAG_SIDE",side);SetLocalInt(pc,"AWG_DRAG_EXP",AWMClock()+12);}return;}
 object dragged=GetLocalObject(pc,"AWG_DRAG");DeleteLocalObject(pc,"AWG_DRAG");if(GetIsObjectValid(dragged) && side!=GetLocalInt(pc,"AWG_DRAG_SIDE") && AWMClock()<=GetLocalInt(pc,"AWG_DRAG_EXP")){AWGSelect(pc,dragged,GetLocalInt(pc,"AWG_DRAG_SIDE"));AWGTransferSelected(pc);}}
