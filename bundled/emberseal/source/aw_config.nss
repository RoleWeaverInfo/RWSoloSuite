json AWQuests(){json a=JsonArray();
a=JsonArrayInsert(a,JsonParse("{\"id\":\"pursuit\",\"name\":\"The queen's missing ward\",\"description\":\"Queen Elowen promises 300 gold when the stolen Emberseal is brought home. Pursue its thieves to Ember Hollow.\",\"start_npc\":\"elowen\",\"completion\":\"Skarn is defeated. The brass-bound strongbox in the vault is now accessible. Recover the Emberseal and return to Queen Elowen.\",\"optional\":0,\"requires\":[],\"gold\":0,\"xp\":100,\"steps\":[{\"id\":\"road\",\"name\":\"Follow the Green Road\",\"description\":\"Leave the market by the main gate and find the Reed farm. Follow the road east through the field and forest, then north to Ember Hollow.\",\"kind\":\"visit\",\"target\":\"reed_farm\",\"next\":\"lookouts\",\"consume\":0,\"choices\":[]},{\"id\":\"lookouts\",\"name\":\"Clear the cave watch\",\"description\":\"Overcome the goblin lookouts guarding the inner cave.\",\"kind\":\"defeat\",\"target\":\"cave_lookouts\",\"next\":\"skarn\",\"consume\":0,\"choices\":[]},{\"id\":\"skarn\",\"name\":\"Defeat Skarn Ashhand\",\"description\":\"Defeat the self-proclaimed king and secure access to his strongbox.\",\"kind\":\"defeat\",\"target\":\"skarn_boss\",\"next\":\"\",\"consume\":0,\"choices\":[]}]}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"homecoming\",\"name\":\"The Emberseal returned\",\"description\":\"Bring the recovered ward-stone back to the queen for the promised reward.\",\"start_npc\":\"\",\"completion\":\"Queen Elowen receives the recovered Emberseal and honors her promise of 300 gold. Briarwatch's wards shine again; your adventure is complete.\",\"optional\":0,\"requires\":[\"pursuit\"],\"gold\":300,\"xp\":500,\"steps\":[{\"id\":\"recover\",\"name\":\"Recover the Emberseal\",\"description\":\"Take the Emberseal from the brass-bound strongbox in the vault.\",\"kind\":\"retrieve\",\"target\":\"emberseal\",\"next\":\"audience\",\"consume\":0,\"choices\":[]},{\"id\":\"audience\",\"name\":\"Return to Queen Elowen\",\"description\":\"Return through the cave, forest, farm and market. Present the recovered Emberseal to Queen Elowen in the throne hall.\",\"kind\":\"talk\",\"target\":\"elowen\",\"next\":\"\",\"consume\":0,\"choices\":[]}]}"));
return a;}
json AWRooms(){json a=JsonArray();
a=JsonArrayInsert(a,JsonParse("{\"id\":\"guard_room\",\"name\":\"Guard room\",\"x\":1,\"y\":1,\"width\":1,\"height\":1,\"description\":\"Preserve the 8x8m footprint. Two normal beds on west wall at local (1.2,1.5) and (1.2,6.5), supply chest (5.8,1.1), table (5.8,6.7); keep east door and centre clear. One compact weapon rack near southeast. No extra beds.\",\"purpose\":\"Guards and practical supplies\",\"interior\":{\"width_m\":8,\"depth_m\":8},\"openings\":[{\"side\":\"east\",\"offset\":4,\"width\":2}],\"area\":\"briar_keep\",\"width_m\":8.0,\"depth_m\":8.0,\"entry_x\":14.0,\"entry_y\":14.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"vestibule\",\"name\":\"Entry vestibule\",\"x\":2,\"y\":1,\"width\":2,\"height\":1,\"description\":\"Indoor 12x8m grey-stone vestibule. South entry (offset 6m, width 3m), north audience door (offset 8m, width 2m), west guard-room door (offset 4m, width 2m). Warm light. Leave entry-to-hall route clear.\",\"purpose\":\"Player arrival and return to market\",\"interior\":{\"width_m\":12,\"depth_m\":8},\"openings\":[{\"side\":\"west\",\"offset\":4,\"width\":2},{\"side\":\"north\",\"offset\":8,\"width\":2},{\"side\":\"south\",\"offset\":6,\"width\":3}],\"area\":\"briar_keep\",\"width_m\":12.0,\"depth_m\":8.0,\"entry_x\":26.0,\"entry_y\":14.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"throne_hall\",\"name\":\"Throne hall\",\"x\":2,\"y\":2,\"width\":2,\"height\":3,\"description\":\"16x24m indoor hall. Dais local (4,19), 8x4m, height .45m, three steps to south. Red/gold runner (6.5,2), 3x15.8m ends at foot of stairs. Genuine throne at local (8,21), facing south. Four large benches at (3,6),(3,12),(13,6),(13,12), long axes north-south, facing inward. Braziers on dais at (5,21),(11,21); banners at rear (5.5,23.4),(10.5,23.4). Statues (1.5,22.4),(14.5,22.4); slim columns at x1.5/14.5, y5/14. Wall lights beside the hall. Leave east study door and centre aisle unobstructed. Never use small chairs as throne or benches.\",\"purpose\":\"Queen, main quest and final audience\",\"interior\":{\"width_m\":16,\"depth_m\":24},\"openings\":[{\"side\":\"south\",\"offset\":8,\"width\":2},{\"side\":\"east\",\"offset\":16,\"width\":2}],\"platforms\":[{\"id\":\"royal_dais\",\"name\":\"Royal dais\",\"x\":4,\"y\":19,\"width\":8,\"depth\":4,\"height\":0.45,\"stair_width\":8,\"stair_run\":1.2,\"stair_offset\":4,\"steps\":3,\"stair_side\":\"south\",\"requirements\":[\"dais\"]}],\"carpets\":[{\"id\":\"red_runner\",\"name\":\"Entrance-to-dais runner\",\"x\":6.5,\"y\":2,\"width\":3,\"depth\":15.8,\"color\":\"red\",\"border\":\"gold\",\"requirements\":[\"carpet\"]}],\"area\":\"briar_keep\",\"width_m\":16.0,\"depth_m\":24.0,\"entry_x\":28.0,\"entry_y\":32.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"council_study\",\"name\":\"Council study\",\"x\":4,\"y\":3,\"width\":1,\"height\":2,\"description\":\"10x12m indoor study. Preserve desk (3,9.5), map table (6,2), bookcase (9,6.5, facing west); two restrained chairs. West door offset 6m connects to throne hall through a fully enclosed 2m corridor.\",\"purpose\":\"Two royal assistants and optional clues\",\"interior\":{\"width_m\":10,\"depth_m\":12},\"openings\":[{\"side\":\"west\",\"offset\":6,\"width\":2}],\"area\":\"briar_keep\",\"width_m\":10.0,\"depth_m\":12.0,\"entry_x\":45.0,\"entry_y\":36.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"market\",\"name\":\"Market courtyard\",\"x\":2,\"y\":12,\"width\":5,\"height\":4,\"description\":\"STONE COURTYARD: (20,120)-(70,160), continuous perimeter walls, paving throughout. Only north castle doorway and south approach arch. Four 5x4m stalls centred at (24.5,148),(24.5,130),(65.5,148),(65.5,130), counters face inward. Well at (38,139). Stall goods: bread, arms/armor, arcane books/scrolls, healing supplies. Two milling peasants; broad clear paths. Not a grass field.\",\"purpose\":\"Safe shopping and local rumors\",\"area\":\"green_road\",\"width_m\":50.0,\"depth_m\":40.0,\"entry_x\":45.0,\"entry_y\":140.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"main_gate\",\"name\":\"Main gate\",\"x\":4,\"y\":8,\"width\":2,\"height\":2,\"description\":\"Paved and walled gatehouse zone (40,80)-(60,100), with north approach and actual south front gate at (50,80), clear width 4m. Stone-walled 4m approach connects north to the courtyard; all side walls continuous. Two soldiers beside the gate. Outside south becomes the countryside dirt pathway.\",\"purpose\":\"Transition from town to wilderness\",\"area\":\"green_road\",\"width_m\":20.0,\"depth_m\":20.0,\"entry_x\":50.0,\"entry_y\":90.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"reed_farm\",\"name\":\"Reed farm\",\"x\":4,\"y\":4,\"width\":3,\"height\":2,\"description\":\"Small farmhouse and barn, crop rows, fence with a usable opening. Wolves at the eastern crop edge. Leave farmhouse entry and road clear.\",\"purpose\":\"Encounter E1 and farmer clue\",\"area\":\"green_road\",\"width_m\":30.0,\"depth_m\":20.0,\"entry_x\":55.0,\"entry_y\":50.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"old_road\",\"name\":\"Open field and old road\",\"x\":9,\"y\":4,\"width\":3,\"height\":2,\"description\":\"Broken cart on the verge. Goblins try to levy an absurd royal toll. A scenic spur heads south away from the city.\",\"purpose\":\"Encounter E2\",\"area\":\"green_road\",\"width_m\":30.0,\"depth_m\":20.0,\"entry_x\":105.0,\"entry_y\":50.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"forest_bend\",\"name\":\"Forest bend\",\"x\":14,\"y\":4,\"width\":3,\"height\":3,\"description\":\"Trees in clumps, a clear winding trail, webbed vegetation off the path. No wall of trees blocking passage.\",\"purpose\":\"Encounter E3\",\"area\":\"green_road\",\"width_m\":30.0,\"depth_m\":30.0,\"entry_x\":155.0,\"entry_y\":55.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"cave_approach\",\"name\":\"Cave approach\",\"x\":14,\"y\":10,\"width\":2,\"height\":2,\"description\":\"A low rocky hill with a clear cave-mouth transition. Scout Rowan waits outside to identify the trail. No encounter on the arrival point.\",\"purpose\":\"Clue and transition to cave\",\"area\":\"green_road\",\"width_m\":20.0,\"depth_m\":20.0,\"entry_x\":150.0,\"entry_y\":110.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"cave_mouth\",\"name\":\"Cave mouth\",\"x\":1,\"y\":1,\"width\":2,\"height\":2,\"description\":\"A safe arrival chamber with a broken lantern at the edge. The south exit returns to the outdoor cave approach.\",\"purpose\":\"Safe entry and return route\",\"interior\":{\"width_m\":20,\"depth_m\":20},\"area\":\"ember_hollow\",\"width_m\":20.0,\"depth_m\":20.0,\"entry_x\":20.0,\"entry_y\":20.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"raiders_watch\",\"name\":\"Raiders watch\",\"x\":5,\"y\":1,\"width\":3,\"height\":2,\"description\":\"Two goblin lookouts, a low barricade with a 3m gap, one campfire, three bedrolls and modest supplies. Keep the north tunnel clear.\",\"purpose\":\"Encounter E4\",\"interior\":{\"width_m\":30,\"depth_m\":20},\"area\":\"ember_hollow\",\"width_m\":30.0,\"depth_m\":20.0,\"entry_x\":65.0,\"entry_y\":20.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"quiet_alcove\",\"name\":\"Quiet alcove\",\"x\":5,\"y\":5,\"width\":2,\"height\":2,\"description\":\"A calm old mining recess between encounters with a healing cache and two mining props.\",\"purpose\":\"Recovery and supplies\",\"interior\":{\"width_m\":20,\"depth_m\":20},\"area\":\"ember_hollow\",\"width_m\":20.0,\"depth_m\":20.0,\"entry_x\":60.0,\"entry_y\":60.0,\"entry_z\":0.0}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"ember_vault\",\"name\":\"Ember vault\",\"x\":9,\"y\":5,\"width\":2,\"height\":3,\"description\":\"Fully enclosed 20x30m rock chamber at (90,50). Only entrance is west at global (90,65), 4m clear heavy wooden doorway in continuous rock jambs. No other opening or exterior walkable floor. One boss; scrap throne near (100,73), quest case (102,77), braziers (92,73),(108,73), broken plinth at (108,54). Keep central battle space and quest case approach free.\",\"purpose\":\"Encounter E5 and Emberseal recovery\",\"interior\":{\"width_m\":20,\"depth_m\":30},\"area\":\"ember_hollow\",\"width_m\":20.0,\"depth_m\":30.0,\"entry_x\":100.0,\"entry_y\":65.0,\"entry_z\":0.0}"));
return a;}
json AWEncounters(){json a=JsonArray();
a=JsonArrayInsert(a,JsonParse("{\"id\":\"orchard_wolves\",\"name\":\"Orchard wolves\",\"room\":\"reed_farm\",\"kind\":\"combat\",\"description\":\"Two hungry wolves prowl the orchard edge after goblins disturbed their forest den. They defend food, not evil masters. Keep them away from the farmhouse and arrival point.\",\"creature\":\"wolf\",\"count\":2,\"maximum\":3,\"scale\":1,\"after_quest\":\"\",\"prompt\":\"\",\"options\":[],\"answer\":0,\"success\":\"\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":0,\"area\":\"green_road\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"road_toll\",\"name\":\"Goblin toll ambush\",\"room\":\"old_road\",\"kind\":\"combat\",\"description\":\"Goblins at a broken cart demand a toll in the name of King Skarn. The cart is roadside cover, not a solid roadblock.\",\"creature\":\"goblin\",\"count\":2,\"maximum\":3,\"scale\":1,\"after_quest\":\"\",\"prompt\":\"\",\"options\":[],\"answer\":0,\"success\":\"\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":1,\"area\":\"green_road\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"wood_spiders\",\"name\":\"Webbed woodland\",\"room\":\"forest_bend\",\"kind\":\"combat\",\"description\":\"A large hunting spider waits in webbed vegetation off the forest bend. Its motives are hunger and nest defense, not knowledge of the theft.\",\"creature\":\"spider\",\"count\":1,\"maximum\":2,\"scale\":1,\"after_quest\":\"\",\"prompt\":\"\",\"options\":[],\"answer\":0,\"success\":\"\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":2,\"area\":\"green_road\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"cave_lookouts\",\"name\":\"Raiders watch\",\"room\":\"raiders_watch\",\"kind\":\"combat\",\"description\":\"Skarn's lookouts camp in the watch chamber. They know their chief and the strongbox but not how the relic works.\",\"creature\":\"goblin\",\"count\":2,\"maximum\":3,\"scale\":1,\"after_quest\":\"\",\"prompt\":\"\",\"options\":[],\"answer\":0,\"success\":\"\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":3,\"area\":\"ember_hollow\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"skarn_boss\",\"name\":\"Skarn Ashhand\",\"room\":\"ember_vault\",\"kind\":\"combat\",\"description\":\"Skarn Ashhand, self-proclaimed King of the Green Road, guards the stolen Emberseal behind a scrap throne. He is brave when watched, insecure in private, and wrong about the seal granting a crown.\",\"creature\":\"goblin_boss\",\"count\":1,\"maximum\":1,\"scale\":0,\"after_quest\":\"\",\"prompt\":\"\",\"options\":[],\"answer\":0,\"success\":\"\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":4,\"area\":\"ember_hollow\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"seal_box\",\"name\":\"Emberseal strongbox\",\"room\":\"ember_vault\",\"kind\":\"treasure\",\"description\":\"A brass-bound oak case with a sunburst clasp, secured behind Skarn's scrap throne.\",\"creature\":\"goblin\",\"count\":1,\"maximum\":3,\"scale\":0,\"after_quest\":\"pursuit\",\"prompt\":\"The stolen Emberseal glows softly inside its protective frame.\",\"options\":[],\"answer\":0,\"success\":\"You have found the queen's missing ward-stone. Bring it back to Briarwatch.\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":5,\"area\":\"ember_hollow\"}"));
a=JsonArrayInsert(a,JsonParse("{\"id\":\"rest_cache\",\"name\":\"Old workers healing cache\",\"room\":\"quiet_alcove\",\"kind\":\"treasure\",\"description\":\"A small dry chest containing two healing draughts; no key or riddle is required.\",\"creature\":\"goblin\",\"count\":1,\"maximum\":3,\"scale\":0,\"after_quest\":\"\",\"prompt\":\"A pair of healing draughts rests in straw.\",\"options\":[],\"answer\":0,\"success\":\"Useful supplies for the return journey.\",\"failure\":\"\",\"gold\":0,\"xp\":0,\"index\":6,\"area\":\"ember_hollow\"}"));
return a;}
