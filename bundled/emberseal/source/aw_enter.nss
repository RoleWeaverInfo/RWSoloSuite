#include "aw_social"
void main(){object pc=GetEnteringObject();if(!GetIsPC(pc))return;if(!GetLocalInt(pc,"AW_WELCOME")){SetLocalInt(pc,"AW_WELCOME",TRUE);SendMessageToPC(pc,"Harvest banners hang over Briarwatch, but its queen has called for help. A guard ushers you toward the throne hall. The Emberseal is missing, and the road beyond the gate has fallen quiet.");}AQStart(pc);AWArea(pc);SPReset(pc);SPPublish(pc);SPServiceBegin(pc);DelayCommand(12.0,SPServiceCheck(pc));SendMessageToPC(pc,"AI: choose Talk freely with AI and then speak normally, or type !talk <alias> <message>. Use !end to finish.");}
