#include "sp_inc"
void main(){object pc=GetLocalObject(OBJECT_SELF,"AWT_OWNER");object target=GetLocalObject(OBJECT_SELF,"AWT_TARGET");if(!AWTBase(pc,OBJECT_SELF) || !AWTRecipient(OBJECT_SELF,target) || GetDistanceBetween(OBJECT_SELF,target)>6.0 || GetLocalInt(OBJECT_SELF,"AWT_PHASE")!=3 || GetLocalInt(OBJECT_SELF,"AWT_TARGET_EPOCH")!=GetLocalInt(target,"AWA_EPOCH"))return;
 if(GetLocalString(OBJECT_SELF,"AWT_SESSION")!=SPSession() || SPNow()-GetLocalInt(OBJECT_SELF,"AWT_SENT")>=90){AWTFinish(pc,OBJECT_SELF,"Visit answer expired; no answer reported.");return;}sqlquery q=SqlPrepareQueryCampaign(SPDB,"SELECT state,response FROM sp_requests WHERE request_id=@id AND session_id=@session");SqlBindString(q,"@id",GetLocalString(OBJECT_SELF,"AWT_REQUEST"));SqlBindString(q,"@session",SPSession());if(!SqlStep(q))return;string state=SqlGetString(q,0);if(state=="queued" || state=="working")return;
 if(state!="ready"){AWTFinish(pc,OBJECT_SELF,"The NPC did not provide a confirmed answer.");return;}json response=JsonParse(SqlGetString(q,1));string answer=GetStringLeft(AWText(response,"reply"),600);if(answer=="" || AWText(response,"action")!="none"){AWTFinish(pc,OBJECT_SELF,"Invalid visit answer discarded.");return;}
 sqlquery ack=SqlPrepareQueryCampaign(SPDB,"UPDATE sp_requests SET state='consumed' WHERE request_id=@id AND session_id=@session AND state='ready'");SqlBindString(ack,"@id",GetLocalString(OBJECT_SELF,"AWT_REQUEST"));SqlBindString(ack,"@session",SPSession());SqlStep(ack);if(SqlGetError(ack)!="")return;
 AssignCommand(target,SpeakString(AWText(AWFind(AWABehaviors(),GetTag(target)),"communication")=="nonverbal"?"*"+answer+"*":answer,TALKVOLUME_TALK));SetLocalString(OBJECT_SELF,"AWT_RESULT","I asked "+GetName(target)+": "+GetLocalString(OBJECT_SELF,"AWT_QUESTION")+" Their answer was: "+answer);DeleteLocalString(target,"AWA_VISIT_LOCK");DeleteLocalString(OBJECT_SELF,"AWT_REQUEST");DeleteLocalString(pc,"AWT_REQUEST");SetLocalInt(OBJECT_SELF,"AWT_PHASE",4);SetLocalString(OBJECT_SELF,"AWT_STATUS","Answer heard; returning to owner.");}

